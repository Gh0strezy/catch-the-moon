local zones = require("./zones")
return function()
	local rows = {
		"# Атлас Лунного меридиана", "",
		"Крыша обсерватории находится у начала координат. Север — −Z, восток — +X. Размеры даны в стадах Roblox. Центр — проектная отметка пола. Границы в таблице обозначают прямоугольник участка в плане, включая его вход и обрамление.", "",
		"## Карта", "",
		"```text",
		"                              СЕВЕР",
		"      04 Спиральная бухта — северный кратер — 03 Призматическая долина",
		"                           /               \\",
		"06 Теневая седловина — 01 Пассаж — КРЫША — 02 Пост — 05 Астероидная гавань",
		"                       |           |           |",
		"                  07 Терраса    Галерея    08 Шельф",
		"                                   ЮГ", "```", "",
		"**Зона A.** Крыша и меридианная арка, четыре действующие станции, два боковых павильона. Витрины достраивает сервер в полосе X от −23 до +23, Z от 29 на юг. Продольная ось галереи остаётся свободной.", "",
		"**Зона B.** Непрерывный реголитовый массив с чашами ударных кратеров, базальтовыми грядами и открытой смотровой площадкой на северном валу. Две боковые рампы соединяют крышу с тропами. Центральная чаша, маршруты и смотровая площадка входят в постоянный общественный ландшафт.", "",
		"**Зоны C и D.** Четыре законсервированных причала и две свободные террасы перечислены ниже. В каждом причале есть Attachment TransportSocket для будущей точки прибытия. Путь к причалу доступен пешком.", "",
		"## Реестр", "",
		"| ID | Название | Район Explorer | Статус | Центр X,Y,Z | Размер X×Z | Границы X / Z | Назначение | Расширение | Связи и направления |",
		"|---|---|---|---|---|---|---|---|---|---|",
	}
	for _,z in ipairs(zones) do
		local x,y,d=unpack(z.center)
		local w,h=unpack(z.size)
		table.insert(rows,string.format("| %s | %s | %s | %s | %d, %d, %d | %d×%d | [%d, %d] / [%d, %d] | %s | %s | %s |",
			z.id,z.name,z.group,z.status,x,y,d,w,h,x-w/2,x+w/2,d-h/2,d+h/2,z.purpose,z.growth,z.links))
	end
	table.insert(rows,"\n## Обновление карты\n")
	table.insert(rows,"Модели находятся в Workspace/World, внутри указанного района. Имя начинается с постоянного адреса. Атрибуты ZoneId, ZoneName, ZoneStatus, ZoneDescription, ZoneCenter и ZoneSize содержат данные участка. Игрокам адреса не показываются.")
	table.insert(rows,"\nРеестр ведётся в tools/world/zones.luau. Новую запись добавляйте в конец. При объединении или закрытии участка сохраняйте занятый номер в реестре. После изменения координат или размеров обновите рельеф и сборку по README. Атлас генерируется из того же реестра.")
	table.insert(rows,"\n**Изменённые территории в первой редакции.** Созданы SPACE-01–SPACE-08. Следующий свободный адрес — SPACE-09.")
	table.insert(rows,"\n**Дальний план.** Направление SPACE-03 отмечает ледяная планета с двумя разломами, SPACE-04 — спиральный сигнал над приёмником. Оба ориентира находятся в DistantSky за границами строительных площадок.")
	return table.concat(rows,"\n").."\n"
end
