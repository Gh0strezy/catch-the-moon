local K=require("./kit")
local old=require("../world/zone-guide")
return function()
	local rows={"# Атлас пространств Catch the Moon","",
		"## Орбитальная станция","",
		"Центральный узел находится в (0, 1.45, 0). Локальная +Z каждого причала направлена наружу. Мосты шириной 14 стадов соединяют базы с центральным променадом. На базе выделен участок 70×66 стадов, включая радиаторы и площадку броска. Границы относительно BaseOrigin: X от −35 до +35, Z от −24 до +42. Расширение идёт вверх с шагом 16 стадов.","",
		"| ID | Модель в World.PlayerBases | Центр привязки X, Y, Z | Статус | Назначение | Вход |",
		"|---|---|---|---|---|---|"}
	for i=1,8 do
		local a=math.rad(22.5+(i-1)*45)
		table.insert(rows,string.format("| SPACE-%02d | Base_%02d | %.2f, %.2f, %.2f | Prepared | Персональная станция, этажи и лассо | Bridge_%02d |",i+8,i,math.sin(a)*K.radius,K.deckY,math.cos(a)*K.radius,i))
	end
	table.insert(rows,"\nВ этой редакции добавлены SPACE-09–16. Следующий свободный адрес — SPACE-17. SPACE-01–08 сохраняют прежние адреса в архивной лунной карте.\n")
	return table.concat(rows,"\n").."\n"..old():gsub("^# Атлас Лунного меридиана","## Архив · Лунный меридиан")
end
