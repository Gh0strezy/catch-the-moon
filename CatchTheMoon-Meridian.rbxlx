    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">MoonCatalog</string>
        <string name="Source"><![CDATA[local Catalog = {MaxLevel=12, SpeedCap=10, StrengthCap=10, Slots=3, PayPeriod=5}
Catalog.Moons = {
	{ id="chalk", name="Меловая", rarity="Обычная", weight=58, hits=2, bounty=8, rent=1, color="D7DDE5", dark="838BA8" },
	{ id="tidal", name="Приливная", rarity="Необычная", weight=27, hits=3, bounty=15, rent=3, color="79E4D6", dark="368A9B" },
	{ id="orchid", name="Орхидея", rarity="Редкая", weight=11, hits=4, bounty=32, rent=7, color="C1A3FF", dark="7955BA" },
	{ id="ember", name="Янтарная", rarity="Эпическая", weight=3.5, hits=5, bounty=70, rent=15, color="FFC377", dark="CD764C" },
	{ id="corona", name="Корона", rarity="Легендарная", weight=0.5, hits=6, bounty=150, rent=32, color="FFE7A1", dark="D9924E" },
}
Catalog.ById = {}
for _,moon in ipairs(Catalog.Moons) do Catalog.ById[moon.id] = moon end

function Catalog.luck(level) return 1 + level * 0.25 end
function Catalog.walkSpeed(level) return 16 + 2 * level end
function Catalog.window(strength) return 0.16 + 0.022 * strength end
function Catalog.repsNeeded(strength) return 3 + strength end

function Catalog.price(stat, level)
	if stat == "level" then return 24 + 18*level + 10*level*level end
	return 20 + 12*level + 8*level*level
end

function Catalog.chances(level)
	local chances = {}
	local weight, previous = 0, 0
	for i,moon in ipairs(Catalog.Moons) do
		weight += moon.weight
		local cumulative = (weight/100)^Catalog.luck(level)
		chances[i] = cumulative - previous
		previous = cumulative
	end
	return chances
end

function Catalog.roll(level, sample)
	local sum = 0
	for i,chance in ipairs(Catalog.chances(level)) do
		sum += chance
		if sample < sum then return i end
	end
	return #Catalog.Moons
end

local function integer(value, maximum)
	if type(value) ~= "number" or value ~= value then return 0 end
	return math.clamp(math.floor(value), 0, maximum or 1e12)
end

function Catalog.inBag(data, id)
	local available = data.counts[id] or 0
	for _,item in ipairs(data.slots) do
		if item == id then available -= 1 end
	end
	return available
end

function Catalog.newProfile(old)
	old = old or {}
	local data = {
		cash = integer(old.cash or old.dust), level = integer(old.level,Catalog.MaxLevel),
		speed = integer(old.speed,Catalog.SpeedCap), strength = integer(old.strength,Catalog.StrengthCap),
		counts = {}, slots = table.create(Catalog.Slots,""),
	}
	data.reps = integer(old.reps,Catalog.repsNeeded(data.strength)-1)
	for _,moon in ipairs(Catalog.Moons) do
		data.counts[moon.id] = integer((old.counts or {})[moon.id])
	end
	for i=1,Catalog.Slots do
		local id = (old.slots or {})[i]
		if Catalog.ById[id] and Catalog.inBag(data,id)>0 then data.slots[i]=id end
	end
	return data
end

function Catalog.income(data)
	local total = 0
	for _,id in ipairs(data.slots) do
		local moon = Catalog.ById[id]
		if moon then total += moon.rent end
	end
	return total
end

function Catalog.place(data, slot, id)
	if type(slot)~="number" or slot%1~=0 or slot<1 or slot>Catalog.Slots then return false end
	if id~="" and (type(id)~="string" or not Catalog.ById[id] or Catalog.inBag(data,id)<1) then return false end
	if data.slots[slot]==id then return false end
	data.slots[slot]=id
	return true
end

function Catalog.buy(data, stat)
	local cap = if stat=="level" then Catalog.MaxLevel elseif stat=="speed" then Catalog.SpeedCap else nil
	if not cap or data[stat]>=cap then return false end
	local price = Catalog.price(stat,data[stat])
	if data.cash<price then return false end
	data.cash-=price
	data[stat]+=1
	return true
end

function Catalog.train(data)
	if data.strength>=Catalog.StrengthCap then return false end
	data.reps+=1
	if data.reps>=Catalog.repsNeeded(data.strength) then
		data.strength+=1
		data.reps=0
	end
	return true
end

function Catalog.award(data,index)
	local moon=Catalog.Moons[index]
	data.counts[moon.id]=(data.counts[moon.id] or 0)+1
	data.cash+=moon.bounty
end

return Catalog
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="8">
      <Properties>
        <string name="Name">LunarStation</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local storage = game:GetService("ReplicatedStorage")
local Catalog = require(storage:WaitForChild("MoonCatalog"))
local Profiles = require(script.ProfileStore)
local Round = require(script.Round)
local Stations = require(script.Stations)
local event = Instance.new("RemoteEvent")
event.Name = "MoonStationEvent"
local sessions, hunting, loading = {}, {}, {}
local rng = Random.new()
local sequence, pending, closing = 0,0,false

local function update(player)
	local s=sessions[player]
	event:FireClient(player,"profile",s.data,s.practice==true)
end
local function message(player,text)
	event:FireClient(player,"notice",text)
end
local function setSpeed(player)
	local session=sessions[player]
	local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if session and humanoid then humanoid.WalkSpeed=Catalog.walkSpeed(session.data.speed) end
end

-- Settle elapsed time at the old rate before changing an exhibit.
local function settle(s)
	local now=os.clock()
	local amount=s.fraction+(now-s.accruedAt)*Catalog.income(s.data)/Catalog.PayPeriod
	local dollars=math.floor(amount)
	s.fraction,s.accruedAt=amount-dollars,now
	s.data.cash+=dollars
	return dollars>0
end
local function endHunt(player,text,index)
	local round=hunting[player]
	hunting[player]=nil
	event:FireClient(player,"finish",text,index)
	event:FireAllClients("lassoEnd",player,round.id,index~=nil)
end

local function lassoPacket(round)
	return {id=round.id,index=round.index,hits=round.hits,goal=round.goal,
		castAt=round.castAt,heading=round.heading}
end

local function sendHunt(player,round,feedback)
	event:FireClient(player,"hunt",round:packet(feedback))
	event:FireAllClients("lasso",player,lassoPacket(round))
end

local function startHunt(player,s)
	if hunting[player] then return end
	local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	sequence+=1
	local now=workspace:GetServerTimeNow()
	local index=Catalog.roll(s.data.level,rng:NextNumber())
	local round=Round.new(sequence,index,Catalog.Moons[index],Catalog.window(s.data.strength),rng,now)
	round.castAt,round.heading=now,root.CFrame.LookVector
	hunting[player]=round
	s.inCircle=Stations.inCatchCircle(player)
	sendHunt(player,round)
end
local function complete(player,round)
	Catalog.award(sessions[player].data,round.index)
	local moon=Catalog.Moons[round.index]
	update(player)
	endHunt(player,moon.name.." в рюкзаке   +$"..moon.bounty,round.index)
end

local function load(player)
	if closing or loading[player] or sessions[player] then return end
	loading[player]=true
	pending+=1
	local s=Profiles.open(player)
	if closing or player.Parent~=Players then
		if s then s:save(true) end
	elseif s then
		s.accruedAt,s.fraction,s.lastUse,s.lastTrain,s.lastSync=os.clock(),0,-10,-10,-10
		sessions[player]=s
		Stations.assign(player)
		Stations.render(player,s.data)
		player.CharacterAdded:Connect(function(char)
			char:WaitForChild("Humanoid",10)
			setSpeed(player)
		end)
		player.CharacterRemoving:Connect(function()
			s.inCircle=false
			if hunting[player] then endHunt(player,"Ловля завершена") end
		end)
		setSpeed(player)
		update(player)
	else
		player:Kick("Коллекция временно недоступна. Зайди через минуту.")
	end
	loading[player]=nil
	pending-=1
end

local function close(player)
	local s=sessions[player]
	sessions[player],hunting[player]=nil,nil
	Stations.remove(player)
	if s then
		pending+=1
		settle(s)
		if not s:save(true) then warn("Could not finish saving lunar collection",player.UserId) end
		pending-=1
	end
end

local function useStation(player,s,key,slot)
	if type(key)~="string" or not Stations.near(player,key,slot) then return end
	if key=="Catch" then
		startHunt(player,s)
	elseif key=="Gym" then
		if os.clock()-s.lastTrain<0.85 then return end
		s.lastTrain=os.clock()
		local old=s.data.strength
		if not Catalog.train(s.data) then message(player,"Сила максимальная") return end
		update(player)
		if s.data.strength>old then
			message(player,string.format("Сила %d · окно теперь %.1f%%",s.data.strength,100*Catalog.window(s.data.strength)))
		else
			message(player,string.format("Подъём штанги   %d / %d",s.data.reps,Catalog.repsNeeded(old)))
		end
	else
		event:FireClient(player,"menu",key,slot)
	end
end

local function strike(player,roundId,step,pressed)
	local round=hunting[player]
	if not round or round.id~=roundId then return end
	if not Stations.near(player,"Catch") then endHunt(player,"Ловля завершена · ты отошёл от телескопа") return end
	local now=workspace:GetServerTimeNow()
	local hit=round:judge(step,pressed,now,math.clamp(player:GetNetworkPing()+0.12,0.16,0.42))
	if hit==nil then return end
	if round.mistakes>=3 then endHunt(player,"Планета ушла с орбиты. Можно искать следующую.") return end
	if round.hits>=round.goal then complete(player,round)
	else sendHunt(player,round,if hit then "Идеально!" else "Мимо") end
	if hit then
		-- A nearby friend's precise hit helps after your first personal success.
		for friend,other in pairs(hunting) do
			if friend~=player and other.ownHit and now<=other.expires and Stations.near(friend,"Catch") then
				other.hits+=1
				if other.hits>=other.goal then complete(friend,other)
				else sendHunt(friend,other,"Помощь напарника") end
			end
		end
	end
end

event.OnServerEvent:Connect(function(player,action,a,b,c)
	local s=sessions[player]
	if not s or s.closed or closing then return end
	if action=="strike" then strike(player,a,b,c) return end
	if action=="cancel" then
		if hunting[player] then endHunt(player,"Ловля завершена") end
		return
	end
	local now=os.clock()
	if action=="sync" then
		if now-s.lastSync<0.5 then return end
		s.lastSync=now
		update(player)
		if hunting[player] then event:FireClient(player,"hunt",hunting[player]:packet()) end
		for owner,round in pairs(hunting) do
			event:FireClient(player,"lasso",owner,lassoPacket(round))
		end
		return
	end
	if now-s.lastUse<0.15 then return end
	s.lastUse=now
	if action=="use" then useStation(player,s,a,b)
	elseif action=="buy" and (a=="Luck" or a=="Speed") and Stations.near(player,a) then
		local stat=if a=="Luck" then "level" else "speed"
		if Catalog.buy(s.data,stat) then
			setSpeed(player)
			update(player)
			message(player,if a=="Luck" then "Удача улучшена" else "Скорость бега увеличена")
		else message(player,"Проверь цену и уровень улучшения") end
	elseif action=="place" and type(a)=="number" and Stations.near(player,"Display",a) then
		local paid=settle(s)
		if Catalog.place(s.data,a,b) then
			Stations.render(player,s.data)
			update(player)
			message(player,if b=="" then "Планета возвращена в рюкзак" else "Планета выставлена")
		elseif paid then update(player) end
	end
end)
event.Parent=storage
Players.PlayerAdded:Connect(load)
Players.PlayerRemoving:Connect(close)
for _,player in ipairs(Players:GetPlayers()) do task.spawn(load,player) end

task.spawn(function()
	while not closing do
		task.wait(0.1)
		for player,s in pairs(sessions) do
			local inside=Stations.inCatchCircle(player)
			if inside and not s.inCircle and not s.closed then startHunt(player,s) end
			s.inCircle=inside
		end
	end
end)

task.spawn(function()
	while not closing do
		task.wait(1)
		for player,s in pairs(sessions) do
			if not s.closed and settle(s) then update(player) end
			local round=hunting[player]
			if round and (workspace:GetServerTimeNow()>round.expires or not Stations.near(player,"Catch")) then
				endHunt(player,"Ловля завершена · вернись к телескопу")
			end
		end
	end
end)
task.spawn(function()
	while not closing do
		task.wait(50)
		for player,s in pairs(sessions) do
			task.spawn(function()
				if not s:save(false) then
					warn("Could not renew lunar collection",player.UserId)
					if s.closed and player.Parent==Players then player:Kick("Коллекция открыта в другой сессии.") end
				end
			end)
		end
	end
end)
game:BindToClose(function()
	closing=true
	for player in pairs(table.clone(sessions)) do task.spawn(close,player) end
	while pending>0 do task.wait(0.1) end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Catalog = require(game.ReplicatedStorage.MoonCatalog)

local ProfileStore = {}
ProfileStore.__index = ProfileStore
local LEASE_SECONDS = 180

function ProfileStore.open(player)
	local self = setmetatable({
		data = Catalog.newProfile(), key = "player_" .. player.UserId,
		token = HttpService:GenerateGUID(false), saving = false, closed = false,
	}, ProfileStore)
	-- Studio playtests use isolated session data, even if production API access is enabled.
	if RunService:IsStudio() then
		self.practice = true
		return self
	end
	for attempt = 1, 3 do
		local ok, record = pcall(function()
			self.store = DataStoreService:GetDataStore("CatchTheMoon_v1")
			return self.store:UpdateAsync(self.key, function(old)
				if old and old.version ~= 1 and old.version ~= 2 then return nil end
				if old and old.owner and old.owner ~= self.token and old.expires > os.time() then return nil end
				return { version = 2, data = Catalog.newProfile(old and old.data),
					owner = self.token, expires = os.time() + LEASE_SECONDS }
			end)
		end)
		if ok and record and record.owner == self.token then
			self.data = record.data
			return self
		end
		if attempt < 3 then task.wait(2 * attempt) end
	end
	return nil
end

function ProfileStore:save(release)
	if self.saving and not release then return true end
	while self.saving do task.wait() end
	if self.practice or self.closed then return true end
	self.saving = true
	local snapshot = Catalog.newProfile(self.data)
	local attempts = if release then 3 else 1
	local success = false
	for attempt = 1, attempts do
		local ok, stored = pcall(function()
			return self.store:UpdateAsync(self.key, function(old)
				if not old or old.owner ~= self.token then return nil end
				return { version = 2, data = snapshot, owner = if release then nil else self.token,
					expires = if release then 0 else os.time() + LEASE_SECONDS }
			end)
		end)
		if ok then
			success = stored ~= nil
			self.closed = release or not success
			break
		end
		if attempt < attempts then task.wait(attempt) end
	end
	self.saving = false
	return success
end

return ProfileStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Round</string>
          <string name="Source"><![CDATA[local Round = {}
Round.__index = Round

function Round.new(id, index, moon, width, random, now)
	local self = setmetatable({
		id=id, index=index, goal=moon.hits, width=width, hits=0, mistakes=0,
		step=0, random=random, period=1.7, ownHit=false, expires=now+90,
	}, Round)
	self:advance(now)
	return self
end

function Round:advance(now)
	self.step+=1
	self.start=now+0.38
	self.center=self.random:NextNumber(0.32,0.78)
end

function Round:packet(feedback)
	return {id=self.id,index=self.index,hits=self.hits,goal=self.goal,mistakes=self.mistakes,
		step=self.step,start=self.start,period=self.period,center=self.center,width=self.width,feedback=feedback}
end

-- Consume one input per step. Bound the client's synchronized timestamp by the connection latency.
function Round:judge(step, pressed, now, maxLag)
	if step~=self.step or type(pressed)~="number" or pressed~=pressed
		or pressed<self.start or now>self.expires or pressed<now-maxLag or pressed>now+0.06 then return nil end
	local phase=((pressed-self.start)/self.period)%1
	local hit=math.abs(phase-self.center)<=self.width/2
	if hit then
		self.ownHit=true
		self.hits+=1
	else
		self.mistakes+=1
	end
	self:advance(now)
	return hit
end
return Round
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Stations</string>
          <string name="Source"><![CDATA[local Catalog = require(game.ReplicatedStorage.MoonCatalog)
local Stations = {}
local hub = workspace:WaitForChild("Observatory")
local static = hub:WaitForChild("Stations")
local catchRing = hub:WaitForChild("TelescopeDeck"):WaitForChild("Azimuth scale")
local gallery = Instance.new("Folder")
gallery.Name, gallery.Parent = "Gallery", hub
local plots, owners, floors = {}, {}, {}

local function block(parent,name,size,frame,color,material)
	local p=Instance.new("Part")
	p.Name,p.Size,p.CFrame=name,size,frame
	p.Color,p.Material=Color3.fromHex(color),material or Enum.Material.Metal
	p.Anchored,p.CanTouch,p.Parent=true,false,parent
	return p
end

local function sign(part,title,color,height)
	local board=Instance.new("BillboardGui")
	board.Name,board.Size,board.StudsOffset="Sign",UDim2.fromOffset(166,35),Vector3.new(0,height,0)
	board.AlwaysOnTop,board.MaxDistance,board.Parent=true,65,part
	local label=Instance.new("TextLabel")
	label.Size,label.BackgroundColor3,label.BackgroundTransparency=UDim2.fromScale(1,1),Color3.fromHex("152038"),0.12
	label.Font,label.TextSize,label.TextColor3=Enum.Font.GothamBold,15,Color3.fromHex(color)
	label.Text,label.Parent=title,board
	local corner=Instance.new("UICorner")
	corner.CornerRadius,corner.Parent=UDim.new(0,8),label
	return label
end

local function prompt(part,key,object,action,hold)
	local mount=Instance.new("Attachment")
	mount.Position=Vector3.new(0,0,0)
	mount.Parent=part
	local p=Instance.new("ProximityPrompt")
	p.Name,p.ObjectText,p.ActionText="StationPrompt",object,action
	p.HoldDuration,p.MaxActivationDistance,p.RequiresLineOfSight=hold or 0,10,false
	p:SetAttribute("MoonStation",key)
	p.Parent=mount
	return p
end

local labels={
	Catch={"Телескоп","Искать планету","F1CB88",7},
	Luck={"Удача","Улучшения","93E7CC",5.4},
	Speed={"Скорость","Улучшения","FFC299",5.6},
	Gym={"Тренажёр силы","Поднять штангу","C1BDFF",5.8},
}
for key,info in pairs(labels) do
	local p=static:WaitForChild(key)
	sign(p,info[1],info[3],info[4])
	prompt(p,key,info[1],info[2],if key=="Gym" then 0.55 else 0)
end

local entry=block(gallery,"GalleryEntrance",Vector3.new(12,0.6,8),CFrame.new(0,1.15,33),"44526A")
sign(entry,"Галерея планет","EBD7AD",6)

function Stations.assign(player)
	local index=1
	while owners[index] do index+=1 end
	owners[index]=player
	local row=math.floor((index-1)/2)
	local z=43+18*row
	if not floors[row] then
		floors[row]=block(gallery,"GalleryDeck"..row,Vector3.new(46,1,18.1),CFrame.new(0,1,z),"384760",Enum.Material.Slate)
		for _,edge in ipairs({-22.8,22.8}) do
			block(gallery,"EdgeLight",Vector3.new(0.22,0.2,18),CFrame.new(edge,1.55,z),"BBA170",Enum.Material.Neon)
		end
	end
	local x=if index%2==1 then -11.5 else 11.5
	local model=Instance.new("Model")
	model.Name,model.Parent="Plot_"..player.UserId,gallery
	model:SetAttribute("OwnerId",player.UserId)
	local plaque=block(model,"Nameplate",Vector3.new(14,1,0.5),CFrame.new(x,2,z+4),"5B5160")
	sign(plaque,player.DisplayName,"FFE4B1",3)
	local plot={index=index,model=model,pads={}}
	plots[player]=plot
	for slot=1,Catalog.Slots do
		local pad=block(model,"Slot"..slot,Vector3.new(0.8,4.2,4.2),CFrame.new(x+(slot-2)*5.5,2,z)*CFrame.Angles(0,0,math.pi/2),"908069")
		pad.Shape=Enum.PartType.Cylinder
		local p=prompt(pad,"Display","Витрина "..slot,"Выбрать планету")
		p:SetAttribute("OwnerId",player.UserId)
		p:SetAttribute("Slot",slot)
		plot.pads[slot]=pad
	end
end

function Stations.render(player,data)
	local plot=plots[player]
	if not plot then return end
	for slot,pad in ipairs(plot.pads) do
		local id=data.slots[slot]
		if pad:GetAttribute("ItemId")==id then continue end
		pad:SetAttribute("ItemId",id)
		local previous=pad:FindFirstChild("Exhibit")
		if previous then previous:Destroy() end
		local moon=Catalog.ById[id]
		if moon then
			local ball=block(pad,"Exhibit",Vector3.one*2.7,CFrame.new(pad.Position+Vector3.yAxis*2.8),moon.color,Enum.Material.SmoothPlastic)
			ball.Shape,ball.CanCollide=Enum.PartType.Ball,false
			for j=1,4 do
				local a=j*1.8
				local crater=block(ball,"Crater",Vector3.one*(0.36+j*0.06),CFrame.new(ball.Position+Vector3.new(math.cos(a),0.2*math.sin(a*2),math.sin(a))*1.15),moon.dark)
				crater.Shape,crater.CanCollide=Enum.PartType.Ball,false
			end
			sign(ball,moon.name.."  ·  $"..moon.rent.."/5 с",moon.color,2.4).Parent.MaxDistance=18
		end
	end
end

local function livingRoot(player)
	local char=player.Character
	local root=char and char:FindFirstChild("HumanoidRootPart")
	local humanoid=char and char:FindFirstChildOfClass("Humanoid")
	return if root and humanoid and humanoid.Health>0 then root else nil
end

local function overRing(position)
	local offset = position - catchRing.Position
	local radius = catchRing.Size.Y / 2
	return offset.Y >= -1 and offset.Y <= 10 and offset.X^2 + offset.Z^2 <= radius^2
end

function Stations.inCatchCircle(player)
	local root = livingRoot(player)
	return root ~= nil and overRing(root.Position)
end

function Stations.near(player,key,slot)
	local root=livingRoot(player)
	if not root then return false end
	if key=="Catch" and overRing(root.Position) then return true end
	local part
	if key=="Display" then
		part=plots[player] and plots[player].pads[slot]
	elseif labels[key] then
		part=static:FindFirstChild(key)
	end
	return part~=nil and (root.Position-part.Position).Magnitude<=12
end

function Stations.remove(player)
	local plot=plots[player]
	if plot then
		plot.model:Destroy()
		owners[plot.index],plots[player]=nil,nil
	end
end
return Stations
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="12">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="13">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="14">
        <Properties>
          <string name="Name">LunarStation</string>
          <string name="Source"><![CDATA[local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Actions=game:GetService("ContextActionService")
local Prompts=game:GetService("ProximityPromptService")
local Input=game:GetService("UserInputService")
local storage=game:GetService("ReplicatedStorage")
local Catalog=require(storage:WaitForChild("MoonCatalog"))
local player=Players.LocalPlayer
local ui=require(script:WaitForChild("Interface")).new(player:WaitForChild("PlayerGui"))
local scene=require(script:WaitForChild("MoonScene")).new()
local event=storage:WaitForChild("MoonStationEvent")
local encounter, sentStep, sentAt=nil,nil,0

Prompts.PromptShown:Connect(function(prompt)
	local owner=prompt:GetAttribute("OwnerId")
	if owner and owner~=player.UserId then prompt.Enabled=false end
end)
Prompts.PromptTriggered:Connect(function(prompt,who)
	local key=prompt:GetAttribute("MoonStation")
	if (who and who~=player) or not key or not ui.data or ui.overlay.Visible then return end
	local owner=prompt:GetAttribute("OwnerId")
	if owner and owner~=player.UserId then return end
	event:FireServer("use",key,prompt:GetAttribute("Slot"))
end)

local function hit()
	if not encounter or ui.overlay.Visible or not ui.data then return end
	local now=workspace:GetServerTimeNow()
	if now<encounter.start or (sentStep==encounter.step and now-sentAt<0.8) then return end
	sentStep,sentAt=encounter.step,now
	event:FireServer("strike",encounter.id,encounter.step,now)
end
ui.hit.Activated:Connect(hit)
ui.cancel.Activated:Connect(function() event:FireServer("cancel") end)
ui.bag.Activated:Connect(function() if ui.data and not encounter then ui:menu("Bag") end end)
ui.close.Activated:Connect(function() ui:menu(nil) end)
ui.confirm.Activated:Connect(function()
	if not ui.canConfirm then return end
	if ui.mode=="Display" then event:FireServer("place",ui.slot,"")
	elseif ui.mode=="Luck" or ui.mode=="Speed" then event:FireServer("buy",ui.mode) end
end)
for i,row in ipairs(ui.rows) do
	row.button.Activated:Connect(function()
		local id=Catalog.Moons[i].id
		if ui.mode=="Display" and Catalog.inBag(ui.data,id)>0 then event:FireServer("place",ui.slot,id) end
	end)
end
Actions:BindActionAtPriority("AlignOrbit",function(_,state)
	if not encounter or ui.overlay.Visible or Input:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
	if state==Enum.UserInputState.Begin then hit() end
	return Enum.ContextActionResult.Sink
end,false,Enum.ContextActionPriority.High.Value,Enum.KeyCode.Space,Enum.KeyCode.ButtonR2)

RunService.RenderStepped:Connect(function()
	if encounter then
		local elapsed=math.max(0,workspace:GetServerTimeNow()-encounter.start)
		ui.marker.Position=UDim2.fromScale((elapsed/encounter.period)%1,0.5)
	end
	if ui.overlay.Visible and ui.mode~="Bag" then
		local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local target
		if ui.mode=="Display" then
			local gallery=workspace.Observatory:FindFirstChild("Gallery")
			local plot=gallery and gallery:FindFirstChild("Plot_"..player.UserId)
			target=plot and plot:FindFirstChild("Slot"..ui.slot)
		else target=workspace.Observatory.Stations:FindFirstChild(ui.mode) end
		if not root or not target or (root.Position-target.Position).Magnitude>12 then ui:menu(nil) end
	end
end)

event.OnClientEvent:Connect(function(kind,a,b,c)
	if kind=="profile" then
		local first=ui.data==nil
		ui.data=a
		ui:refresh()
		if first then ui:notice("Забеги в золотой круг у телескопа, чтобы бросить лассо") end
	elseif kind=="hunt" then
		local new=not encounter or encounter.id~=a.id
		if new then
			ui:menu(nil)
			sentStep=nil
		end
		encounter=a
		ui.bag.Visible=false
		ui:hunt(a)
	elseif kind=="finish" then
		encounter=nil
		ui.bag.Visible=true
		ui:hunt(nil)
		ui:notice(a)
	elseif kind=="lasso" then scene:progress(a,b)
	elseif kind=="lassoEnd" then scene:finish(a,b,c)
	elseif kind=="menu" then ui:menu(a,b)
	elseif kind=="notice" then ui:notice(a) end
end)
event:FireServer("sync")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Interface</string>
            <string name="Source"><![CDATA[local Catalog = require(game.ReplicatedStorage:WaitForChild("MoonCatalog"))
local Interface = {}
Interface.__index = Interface

local ink, panel, line = Color3.fromHex("11182B"), Color3.fromHex("202B43"), Color3.fromHex("53637F")
local paper, muted, gold = Color3.fromHex("F2EFE6"), Color3.fromHex("B5C4DD"), Color3.fromHex("FFD391")
local function box(class, parent, name, size, pos, color)
	local o = Instance.new(class)
	o.Name, o.Size, o.Position = name, size, pos
	o.BorderSizePixel = 0
	o.BackgroundColor3 = color or ink
	o.BackgroundTransparency = if color then 0 else 1
	o.Parent = parent
	return o
end
local function shape(o, radius, border)
	local corner = Instance.new("UICorner")
	corner.CornerRadius, corner.Parent = UDim.new(0,radius), o
	if border then
		local s = Instance.new("UIStroke")
		s.Color, s.Transparency, s.ApplyStrokeMode, s.Parent = border, 0.2, Enum.ApplyStrokeMode.Border, o
	end
end
local function label(parent, name, value, size, pos, textSize, color, font)
	local o = box("TextLabel",parent,name,size,pos)
	o.Text, o.TextSize, o.TextColor3 = value,textSize,color or paper
	o.Font = font or Enum.Font.GothamMedium
	o.TextXAlignment = Enum.TextXAlignment.Left
	return o
end
local function button(parent,name,value,size,pos,color)
	local o = box("TextButton",parent,name,size,pos,color or panel)
	o.Text, o.TextSize, o.Font = value,16,Enum.Font.GothamBold
	o.TextColor3 = if color == gold then ink else paper
	o.AutoButtonColor = true
	shape(o,10,if color == gold then nil else line)
	return o
end
local function fit(o, maxWidth, maxHeight)
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize, limit.Parent = Vector2.new(maxWidth,maxHeight), o
end

function Interface.new(parent)
	local self=setmetatable({rows={}},Interface)
	local gui=Instance.new("ScreenGui")
	gui.Name,gui.ResetOnSpawn,gui.DisplayOrder="MoonStation",false,3
	gui.ZIndexBehavior,gui.Parent=Enum.ZIndexBehavior.Sibling,parent
	local header=box("Frame",gui,"Status",UDim2.new(1,-24,0,56),UDim2.fromOffset(12,5))
	local balance=box("Frame",header,"Wallet",UDim2.fromOffset(174,49),UDim2.fromOffset(0,0),ink)
	shape(balance,10,line)
	self.cash=label(balance,"Cash","$0",UDim2.fromOffset(150,24),UDim2.fromOffset(11,2),20,gold,Enum.Font.GothamBold)
	self.rate=label(balance,"Income","Витрины  +$0 / 5 с",UDim2.fromOffset(158,19),UDim2.fromOffset(11,26),12,muted)
	self.bag=button(header,"Bag","Рюкзак",UDim2.fromOffset(98,40),UDim2.new(1,-98,0,0))

	self.toast=label(gui,"Notice","",UDim2.new(1,-28,0,44),UDim2.new(0.5,0,0,62),15,paper)
	self.toast.AnchorPoint=Vector2.new(0.5,0)
	self.toast.TextXAlignment=Enum.TextXAlignment.Center
	self.toast.BackgroundColor3,self.toast.BackgroundTransparency,self.toast.TextWrapped=ink,0.1,true
	fit(self.toast,450,44)
	shape(self.toast,10)
	self.toast.Visible=false

	local dock=box("Frame",gui,"Capture",UDim2.new(1,-20,0,122),UDim2.new(0.5,0,1,-10),ink)
	dock.AnchorPoint,dock.Visible=Vector2.new(0.5,1),false
	shape(dock,14,line)
	fit(dock,506,124)
	self.dock=dock
	self.target=label(dock,"Target","",UDim2.new(1,-92,0,23),UDim2.fromOffset(13,6),16,paper,Enum.Font.GothamBold)
	self.progress=label(dock,"Progress","",UDim2.fromOffset(70,22),UDim2.new(1,-83,0,7),15,gold)
	self.progress.TextXAlignment=Enum.TextXAlignment.Right
	self.hint=label(dock,"Hint","",UDim2.new(1,-20,0,18),UDim2.fromOffset(13,28),12,muted)
	local bar=box("Frame",dock,"Track",UDim2.new(1,-28,0,13),UDim2.fromOffset(14,51),panel)
	shape(bar,5)
	self.zone=box("Frame",bar,"PerfectWindow",UDim2.fromScale(0.16,1),UDim2.fromOffset(0,0),Color3.fromHex("84DBBB"))
	shape(self.zone,4)
	self.marker=box("Frame",bar,"Pointer",UDim2.fromOffset(4,23),UDim2.fromScale(0,0.5),paper)
	self.marker.AnchorPoint=Vector2.new(0.5,0.5)
	self.hit=button(dock,"Strike","Поймать",UDim2.new(0.72,-16,0,40),UDim2.fromOffset(13,74),gold)
	self.cancel=button(dock,"Cancel","Выйти",UDim2.new(0.28,-14,0,40),UDim2.new(0.72,1,0,74))

	local shade=box("TextButton",gui,"Backdrop",UDim2.fromScale(1,1),UDim2.fromOffset(0,0),ink)
	shade.Text,shade.AutoButtonColor,shade.BackgroundTransparency="",false,0.28
	shade.Visible,shade.ZIndex=false,10
	self.overlay=shade
	local sheet=box("Frame",shade,"Sheet",UDim2.new(1,-22,1,-16),UDim2.fromScale(0.5,0.5),ink)
	sheet.AnchorPoint,sheet.Active=Vector2.new(0.5,0.5),true
	fit(sheet,472,450)
	shape(sheet,15,line)
	self.heading=label(sheet,"Title","",UDim2.new(1,-70,0,30),UDim2.fromOffset(16,10),23,paper,Enum.Font.GothamBold)
	self.close=button(sheet,"Close","×",UDim2.fromOffset(36,36),UDim2.new(1,-47,0,8))
	self.summary=label(sheet,"Summary","",UDim2.new(1,-32,0,29),UDim2.fromOffset(16,43),13,muted)
	self.summary.TextWrapped=true
	local list=box("ScrollingFrame",sheet,"Items",UDim2.new(1,-24,1,-138),UDim2.fromOffset(12,74))
	list.ScrollBarThickness,list.ScrollBarImageColor3=4,line
	self.list=list
	for i,moon in ipairs(Catalog.Moons) do
		local b=button(list,moon.id,"",UDim2.new(1,-7,0,49),UDim2.fromOffset(0,(i-1)*55))
		local swatch=box("Frame",b,"Sample",UDim2.fromOffset(25,25),UDim2.fromOffset(10,12),Color3.fromHex(moon.color))
		shape(swatch,13)
		local crater=box("Frame",swatch,"Crater",UDim2.fromOffset(8,8),UDim2.fromOffset(5,6),Color3.fromHex(moon.dark))
		shape(crater,4)
		label(b,"Name",moon.name,UDim2.new(1,-111,0,22),UDim2.fromOffset(44,3),15,paper,Enum.Font.GothamBold)
		local note=label(b,"Detail","",UDim2.new(1,-50,0,18),UDim2.fromOffset(44,26),12,muted)
		local qty=label(b,"Quantity","",UDim2.fromOffset(62,20),UDim2.new(1,-70,0,4),14,Color3.fromHex(moon.color))
		qty.TextXAlignment=Enum.TextXAlignment.Right
		self.rows[i]={button=b,note=note,qty=qty}
	end
	self.info=label(list,"UpgradeDetails","",UDim2.new(1,-14,0,95),UDim2.fromOffset(8,4),18,paper)
	self.info.TextWrapped=true
	self.confirm=button(sheet,"Confirm","",UDim2.new(1,-24,0,43),UDim2.new(0,12,1,-53),gold)
	return self
end

function Interface:notice(text)
	self.toast.Text=text
	self.toast.Visible=true
	self.noticeId=(self.noticeId or 0)+1
	local id=self.noticeId
	task.delay(4,function() if self.noticeId==id then self.toast.Visible=false end end)
end

function Interface:menu(mode,slot)
	self.mode,self.slot=mode,slot
	self.overlay.Visible=mode~=nil
	self.list.CanvasPosition=Vector2.zero
	self:refresh()
end

function Interface:refresh()
	local d=self.data
	if not d then return end
	self.cash.Text="$"..d.cash
	self.rate.Text=string.format("Витрины   +$%d / 5 с",Catalog.income(d))
	if not self.mode then return end
	local exhibition=self.mode=="Display"
	local shop=self.mode=="Luck" or self.mode=="Speed"
	local stat=if self.mode=="Luck" then "level" else "speed"
	local chances=Catalog.chances(d.level)
	local equipped=exhibition and Catalog.ById[d.slots[self.slot]]
	self.heading.Text=if exhibition then "Витрина "..self.slot elseif self.mode=="Luck" then "Мастерская удачи"
		elseif shop then "Скорость бега" else "Рюкзак"
	self.summary.Text=if exhibition then (if equipped then "Выставлена "..equipped.name..". Выбери замену." else "Выбери планету для витрины")
		else string.format("Удача ×%.2f   ·   Скорость %d   ·   Сила %d",Catalog.luck(d.level),Catalog.walkSpeed(d.speed),d.strength)
	self.info.Visible=shop
	self.list.CanvasSize=UDim2.fromOffset(0,if shop then 106 else #self.rows*55)
	for i,row in ipairs(self.rows) do
		local moon=Catalog.Moons[i]
		local bag=Catalog.inBag(d,moon.id)
		row.button.Visible=not shop
		row.button.AutoButtonColor=exhibition and bag>0
		row.qty.Text="×"..bag
		row.note.Text=string.format("%.2f%%   ·   %d попад.   ·   $%d / 5 с",chances[i]*100,moon.hits,moon.rent)
	end
	self.confirm.Visible=shop or exhibition
	local enabled=false
	if shop then
		local level=d[stat]
		local capped=level>=(if stat=="level" then Catalog.MaxLevel else Catalog.SpeedCap)
		local nextLevel=if capped then level else level+1
		local price=Catalog.price(stat,level)
		self.info.Text=if stat=="level" then string.format("Удача ×%.2f → ×%.2f\nШанс легендарной %.2f%% → %.2f%%",Catalog.luck(level),Catalog.luck(nextLevel),chances[5]*100,Catalog.chances(nextLevel)[5]*100)
			else string.format("Скорость %d → %d\nстудов в секунду",Catalog.walkSpeed(level),Catalog.walkSpeed(nextLevel))
		enabled=not capped and d.cash>=price
		self.confirm.Text=if capped then "Максимальный уровень" elseif enabled then "Улучшить за $"..price else "Цена $"..price.."  ·  Нужно ещё $"..(price-d.cash)
	elseif exhibition then
		enabled=equipped~=nil
		self.confirm.Text=if enabled then "Вернуть планету в рюкзак" else "Витрина свободна"
	end
	self.confirm.AutoButtonColor=enabled
	self.confirm.BackgroundColor3=if enabled then gold else panel
	self.confirm.TextColor3=if enabled then ink else muted
	self.canConfirm=enabled
end

function Interface:hunt(packet)
	self.dock.Visible=packet~=nil
	if not packet then return end
	local planet=Catalog.Moons[packet.index]
	self.target.Text=planet.name.."   ·   "..planet.rarity
	self.progress.Text=string.format("%d / %d",packet.hits,packet.goal)
	self.hint.Text=(packet.feedback or "Нажми в зелёной зоне").."   ·   Промахи "..packet.mistakes.."/3"
	self.zone.Size=UDim2.fromScale(packet.width,1)
	self.zone.Position=UDim2.fromScale(packet.center-packet.width/2,0)
end
return Interface
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Lasso</string>
            <string name="Source"><![CDATA[local Lasso = {}
Lasso.__index = Lasso

local windup = 0.26
local castTime = 0.46
local reelTime = 0.62
local gold = Color3.fromHex("FFD78A")
local pearl = Color3.fromHex("FFF2D6")
local ropeColor = ColorSequence.new(gold, pearl)

local function ease(t)
	t = math.clamp(t, 0, 1)
	return t*t*(3-2*t)
end

local function beam(parent, from, to, width)
	local line = Instance.new("Beam")
	line.Attachment0, line.Attachment1 = from, to
	line.Width0, line.Width1 = width, width
	line.Color, line.LightEmission = ropeColor, 1
	line.FaceCamera, line.Segments = true, 10
	line.Parent = parent
	return line
end

function Lasso.new(owner, packet, moon)
	local flat = Vector3.new(packet.heading.X, 0, packet.heading.Z)
	local facing = if flat.Magnitude > 0.01 then flat.Unit else -Vector3.zAxis
	local self = setmetatable({
		id = packet.id, owner = owner, moon = moon, castAt = packet.castAt,
		orientation = CFrame.lookAt(Vector3.zero, facing), progress = packet.hits/packet.goal,
		target = packet.hits/packet.goal, pulse = 0, loadedAt = os.clock(),
		nodes = {}, arcs = {},
	}, Lasso)

	local rig = Instance.new("Part")
	rig.Name, rig.Size, rig.Transparency = "LassoLoop", Vector3.one*0.1, 1
	rig.Anchored, rig.CanCollide, rig.CanTouch, rig.CanQuery, rig.CastShadow = true, false, false, false
	self.rig = rig
	for i = 1, 4 do
		local node = Instance.new("Attachment")
		node.Parent = rig
		self.nodes[i] = node
	end
	for i, node in ipairs(self.nodes) do
		self.arcs[i] = beam(rig, node, self.nodes[i%4+1], 0.105)
	end

	local surface = moon.PrimaryPart
	local left, right = Instance.new("Attachment"), Instance.new("Attachment")
	left.Position, right.Position = Vector3.new(-1.1,0,0), Vector3.new(1.1,0,0)
	left.Parent, right.Parent = surface, surface
	local trail = Instance.new("Trail")
	trail.Name, trail.Attachment0, trail.Attachment1 = "Stardust", left, right
	trail.Lifetime, trail.MinLength, trail.FaceCamera, trail.LightEmission = 0.38, 0.06, true, 1
	trail.Color = ColorSequence.new(surface.Color, pearl)
	trail.Transparency = NumberSequence.new(0.3, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Parent = surface

	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Rate, sparks.Lifetime, sparks.Speed = 0, NumberRange.new(0.25,0.48), NumberRange.new(2,5)
	sparks.Color, sparks.LightEmission, sparks.SpreadAngle = ropeColor, 1, Vector2.new(180,180)
	sparks.Size = NumberSequence.new(0.26, 0)
	sparks.Parent = rig
	self.sparks = sparks
	return self
end

function Lasso:bindHand()
	local char = self.owner.Character
	if not char then return false end
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	local root = char:FindFirstChild("HumanoidRootPart")
	if not hand or not root then return false end
	self.character, self.root = char, root
	local grip = Instance.new("Attachment")
	local handle = hand:FindFirstChild("RightGripAttachment")
	grip.Position = if handle then handle.Position else Vector3.new(0,-hand.Size.Y*0.45,0)
	grip.Name, grip.Parent = "LassoGrip", hand
	self.grip = grip
	self.rope = beam(self.rig, grip, self.nodes[1], 0.085)
	local shoulder = char:FindFirstChild("RightShoulder", true) or char:FindFirstChild("Right Shoulder", true)
	if shoulder and shoulder:IsA("Motor6D") then
		self.shoulder, self.rest = shoulder, shoulder.C0
	end
	self.rig.Parent = workspace
	return true
end

function Lasso:setHits(packet)
	local fraction = packet.hits / packet.goal
	if fraction > self.target then
		self.target, self.pulse = fraction, 1
		if self.grip then self.sparks:Emit(6) end
	end
end

function Lasso:finish(caught)
	if self.endedAt then return end
	self.endedAt, self.caught = workspace:GetServerTimeNow(), caught
	self.endPosition = self.position
	self.endScale = self.scale or 0.5
end

function Lasso:step(now, dt)
	if not self.grip and not self:bindHand() then
		return not self.endedAt and os.clock()-self.loadedAt < 8
	end
	if self.owner.Character ~= self.character or not self.grip.Parent or not self.root.Parent then return false end
	local age = math.max(0, now-self.castAt)
	local finishAge = if self.endedAt then now-self.endedAt else 0
	if self.endedAt and finishAge >= (if self.caught then reelTime+0.6 else 0.42) then return false end
	self.progress += (self.target-self.progress)*(1-math.exp(-dt*7))
	self.pulse = math.max(0,self.pulse-dt*3.5)

	local throw = ease((age-windup)/castTime)
	local swing = ease(age/windup)
	local pull = self.progress
	local phase = math.max(0,age-windup-castTime)*1.65
	local aim = CFrame.new(self.root.Position)*self.orientation
	local offset = Vector3.new(math.sin(phase)*(4.8-3.8*pull),
		5.8-2.5*pull+math.sin(phase)*0.95, -10+5*pull+(1-math.cos(phase))*1.25)
	local position = aim:PointToWorldSpace(offset)
	local scale = 0.50-0.24*pull
	local palm = self.grip.WorldPosition
	local reel = if self.endedAt and self.caught then ease(finishAge/reelTime) else 0
	if self.endedAt then
		local start = self.endPosition or position
		if self.caught then
			position = start:Lerp(palm+Vector3.yAxis*0.38, reel) + Vector3.yAxis*math.sin(math.pi*reel)*1.7
			scale = self.endScale+(0.095-self.endScale)*reel
		else
			position = start + aim:VectorToWorldSpace(Vector3.new(1,5,-7))*ease(finishAge/0.42)
			scale = self.endScale*(1-0.92*ease(finishAge/0.42))
		end
	end
	self.position = position
	if not self.scale or math.abs(self.scale-scale)>0.002 then
		self.moon:ScaleTo(scale)
		self.scale = scale
	end
	self.moon:PivotTo(CFrame.new(position)*CFrame.Angles(0,age*0.55,0.12*math.sin(phase)))
	if not self.moon.Parent then self.moon.Parent = workspace end

	local launch = palm + aim:VectorToWorldSpace(Vector3.new(0.15,0.8,-0.24))
	local loop = launch:Lerp(position,throw) + Vector3.yAxis*(math.sin(math.pi*throw)*2.5)
	local radius = (0.22+0.8*swing)*(1-throw) + scale*5.05*throw
	self.rig.CFrame = CFrame.new(loop)*self.orientation*CFrame.Angles(-0.32, (1-throw)*swing*math.pi*2, 0.35)
	local visible = not self.endedAt or (self.caught and reel<0.96)
	for i,node in ipairs(self.nodes) do
		local angle = (i-1)*math.pi/2
		node.Position = Vector3.new(math.sin(angle)*radius, 0, math.cos(angle)*radius)
		node.Axis = Vector3.new(math.cos(angle), 0, -math.sin(angle))
		local arc = self.arcs[i]
		arc.CurveSize0, arc.CurveSize1 = radius*0.552285, radius*0.552285
		arc.Enabled = visible
	end
	self.rope.CurveSize0 = (1-throw)*1.7 + (1-pull)*0.45
	self.rope.CurveSize1 = -self.rope.CurveSize0
	self.rope.Width0, self.rope.Enabled = 0.085+self.pulse*0.065, visible
	if self.shoulder and self.shoulder.Parent then
		local lift = 0.55 + swing*1.55 - throw*1.08 + self.pulse*0.24 + reel*0.35
		self.shoulder.C0 = CFrame.new(self.rest.Position)*CFrame.Angles(lift,0,0.18)*self.rest.Rotation
	end
	if self.caught and reel>=0.96 and not self.flared then
		self.flared = true
		self.sparks:Emit(22)
	end
	return true
end

function Lasso:destroy()
	if self.shoulder and self.shoulder.Parent then self.shoulder.C0 = self.rest end
	if self.grip then self.grip:Destroy() end
	self.rig:Destroy()
	self.moon:Destroy()
end

return Lasso
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">MoonScene</string>
            <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local Catalog = require(game.ReplicatedStorage:WaitForChild("MoonCatalog"))
local Lasso = require(script.Parent:WaitForChild("Lasso"))
local MoonScene = {}
MoonScene.__index = MoonScene

local center = Vector3.new(0, 16, 0)
local radius = 4.8
local function part(model, name, shape, size, frame, color, material)
	local p = Instance.new("Part")
	p.Name, p.Shape, p.Size, p.CFrame = name, shape, size, frame
	p.Anchored, p.CanCollide, p.CanTouch, p.CastShadow = true, false, false, false
	p.CanQuery = name == "LunarSurface"
	p.Material, p.Color, p.Parent = material or Enum.Material.SmoothPlastic, color, model
	return p
end

local function orbit(model, width, depth, tilt, color, thickness, segments)
	local last
	for i = 0, segments do
		local a = 2 * math.pi * i / segments
		local v = tilt:PointToWorldSpace(Vector3.new(math.cos(a)*width, 0, math.sin(a)*depth))
		if last then
			local p = part(model, "Orbit", Enum.PartType.Block, Vector3.new(thickness, thickness, (v-last).Magnitude+0.02),
				CFrame.lookAt((v+last)/2, v), color, Enum.Material.Neon)
			p.Transparency = 0.25
		end
		last = v
	end
end

local function makeMoon(moon, index, compact)
	local model = Instance.new("Model")
	model.Name = if moon then "LassoMoon" else "PersonalMoon"
	local tint = Color3.fromHex(if moon then moon.color else "D7E2F3")
	local shade = Color3.fromHex(if moon then moon.dark else "879ABC")
	local ball = part(model, "LunarSurface", Enum.PartType.Ball, Vector3.one*radius*2, CFrame.identity, tint)
	model.PrimaryPart = ball
	local rng = Random.new(116)
	local craterCount = if compact then 9 else 37
	for i=1,craterCount do
		local y = 1 - (i-0.5)*2/craterCount
		local a = i*2.39996
		local n = Vector3.new(math.sqrt(1-y*y)*math.cos(a), y, math.sqrt(1-y*y)*math.sin(a))
		local tangent = n:Cross(Vector3.yAxis).Unit
		local size = rng:NextNumber(0.48,1.52)
		local surface = CFrame.fromMatrix(n*(radius-0.025), n, tangent)
		part(model,"Crater rim",Enum.PartType.Cylinder,Vector3.new(0.07,size,size*0.91),surface,tint:Lerp(shade,0.26))
		part(model,"Crater floor",Enum.PartType.Cylinder,Vector3.new(0.08,size*0.75,size*0.70),
			surface*CFrame.new(0.028,size*0.03,0),tint:Lerp(shade,0.55))
	end
	local tilt = CFrame.Angles(math.rad(-12),0,math.rad(-19))
	local segments = if compact then 20 else 48
	orbit(model,7.2,6.3,tilt,Color3.fromHex("DEB67D"),0.052,segments)
	if index and index >= 3 then
		orbit(model,7.6,7,tilt,tint,0.11,segments)
	end
	if index and index >= 4 then
		part(model,"Satellite",Enum.PartType.Ball,Vector3.one*1.15,tilt*CFrame.new(-7,0,1),shade,Enum.Material.Neon)
	end
	if index == 5 then
		orbit(model,7.5,6.8,CFrame.Angles(0,0,1.12),tint,0.09,segments)
	end
	local glow = Instance.new("PointLight")
	glow.Color, glow.Brightness, glow.Range, glow.Parent = tint, 2, 32, ball
	return model
end

function MoonScene.new()
	local self = setmetatable({active = {}, idle = makeMoon(), elapsed = 0, time = 0}, MoonScene)
	RunService:BindToRenderStep("LunarObservatoryView", Enum.RenderPriority.Camera.Value+1, function(dt)
		self.elapsed += dt
		if self.elapsed < 1/30 then return end
		dt, self.elapsed = self.elapsed, 0
		self.time += dt
		local now = workspace:GetServerTimeNow()
		for owner,lasso in pairs(self.active) do
			if not lasso:step(now,dt) then self:remove(owner) end
		end
		if next(self.active) == nil then
			self.idle:PivotTo(CFrame.new(center + Vector3.yAxis*math.sin(self.time*1.3)*0.21)
				* CFrame.Angles(0,self.time*0.065,0))
			if not self.idle.Parent then self.idle.Parent = workspace end
		end
	end)
	Players.PlayerRemoving:Connect(function(owner) self:remove(owner) end)
	return self
end

function MoonScene:remove(owner)
	local lasso = self.active[owner]
	if lasso then
		lasso:destroy()
		self.active[owner] = nil
	end
end

function MoonScene:progress(owner, packet)
	if not owner then return end
	local lasso = self.active[owner]
	if lasso and lasso.id == packet.id then
		lasso:setHits(packet)
		return
	end
	self:remove(owner)
	self.idle.Parent = nil
	local moon = makeMoon(Catalog.Moons[packet.index], packet.index, owner~=Players.LocalPlayer)
	moon:SetAttribute("OwnerId", owner.UserId)
	self.active[owner] = Lasso.new(owner, packet, moon)
end

function MoonScene:finish(owner, id, caught)
	local lasso = self.active[owner]
	if lasso and lasso.id == id then lasso:finish(caught) end
end

return MoonScene
]]></string>
          </Properties>
        </Item>
      </Item>
