    <Item class="ModuleScript" referent="5">
      <Properties>
        <string name="Name">MoonCatalog</string>
        <string name="Source"><![CDATA[local Catalog = {MaxLevel=12, SpeedCap=10, StrengthCap=10, Slots=3, PayPeriod=5}
Catalog.Sets = { solar = "Солнечная система" }
Catalog.Rarities = {
	{ name="Обычная", weight=58, bounty=8, rent=1 },
	{ name="Необычная", weight=27, bounty=15, rent=3 },
	{ name="Редкая", weight=11, bounty=32, rent=7 },
	{ name="Эпическая", weight=3.5, bounty=70, rent=15 },
	{ name="Легендарная", weight=0.5, bounty=150, rent=32 },
}

-- Geometry uses body radii, degrees of latitude/longitude, and hex colours.
Catalog.Planets = {
	{ id="mercury", name="Меркурий", set="solar", tier=1, appearance={
		color="ADB0B4", craters={count=28, seed=11, rim="C9C8C3", floor="75777F"},
	} },
	{ id="mars", name="Марс", set="solar", tier=1, appearance={
		color="CB6242", craters={count=16, seed=38, rim="B85234", floor="99452F"},
		parts={{name="PolarCap", shape="Ball", size={0.72,0.20,0.68}, position={0,0.92,0}, color="F4DDCB"}},
		patches={{-10,12,0.65,0.14,"873F30"},{-7,39,0.34,0.10,"954532"}},
	} },
	{ id="venus", name="Венера", set="solar", tier=2, appearance={
		color="E6B36F", tilt=14, bands={{42,0.13,"F8D798"},{19,0.09,"DFA361"},
			{8,0.18,"F2CA89"},{-18,0.12,"CC955E"},{-39,0.16,"F1C588"}},
	} },
	{ id="earth", name="Земля", set="solar", tier=2, appearance={
		color="286BB0", parts={
			{name="Arctic", shape="Ball", size={0.74,0.23,0.79}, position={0,0.9,0}, color="E8F5EE"},
			{name="Antarctica", shape="Ball", size={0.88,0.27,0.83}, position={0,-0.88,0}, color="D7ECE8"},
		},
		-- Overlapping landforms trace Africa, Europe, Asia, the Americas and Australia.
		patches={{13,0,0.69,0.51,"69914B"},{-6,12,0.43,0.63,"729951"},
			{-22,16,0.24,0.40,"80A458"},{45,14,0.53,0.31,"779850"},
			{46,54,0.78,0.45,"7D9A57"},{50,91,0.83,0.51,"759253"},
			{26,75,0.30,0.47,"9BA660"},{31,107,0.59,0.49,"6A904C"},
			{49,-103,0.79,0.66,"74934F"},{26,-99,0.31,0.43,"8AA15A"},
			{13,-84,0.24,0.18,"78964D"},{-8,-56,0.54,0.66,"528A53"},
			{-35,-66,0.23,0.52,"7F9B59"},{-25,134,0.51,0.38,"B39B61"},
			{72,-42,0.35,0.36,"D5EAE4"},{-19,47,0.09,0.20,"85A45C"}},
	} },
	{ id="uranus", name="Уран", set="solar", tier=3, appearance={
		color="8DDCD9", tilt=70, bands={{36,0.10,"ADE9E2"},{-17,0.08,"77C9CD"}},
		rings={{inner=1.32,outer=1.35,color="B4DAD6"}},
	} },
	{ id="jupiter", name="Юпитер", set="solar", tier=3, appearance={
		color="E9C99F", bands={{54,0.13,"B99477"},{37,0.13,"F7DFB9"},
			{20,0.19,"B77652"},{6,0.10,"F6DDB1"},{-17,0.20,"C68A63"},
			{-36,0.12,"F5DDB3"},{-51,0.13,"AE836D"}},
		patches={{-18,8,0.54,0.30,"F3C796"},{-18,8,0.43,0.23,"B24D37",0.025}},
	} },
	{ id="saturn", name="Сатурн", set="solar", tier=4, appearance={
		color="E4C590", tilt=23, bands={{27,0.14,"EED6A4"},{-14,0.15,"C6A374"}},
		rings={{inner=1.20,outer=1.46,color="B69978"},{inner=1.46,outer=1.72,color="ECD5A4"},
			{inner=1.77,outer=1.92,color="C8AC86"}},
	} },
	{ id="neptune", name="Нептун", set="solar", tier=5, appearance={
		color="3858C7", tilt=-12, bands={{24,0.08,"6182E1"},{-31,0.10,"2949AE"}},
		patches={{-19,4,0.42,0.22,"253788"},{-8,17,0.49,0.07,"B1CEFA"}},
	} },
}

local legacyIds = {chalk="mercury", tidal="venus", orchid="uranus", ember="saturn", corona="neptune"}
Catalog.ById = {}
local tierSizes = {}
for _, planet in ipairs(Catalog.Planets) do
	local rarity = Catalog.Rarities[planet.tier]
	planet.rarity, planet.bounty, planet.rent = rarity.name, rarity.bounty, rarity.rent
	Catalog.ById[planet.id] = planet
	tierSizes[planet.tier] = (tierSizes[planet.tier] or 0) + 1
end

function Catalog.luck(level) return 1 + level * 0.25 end
function Catalog.walkSpeed(level) return 16 + 2 * level end
function Catalog.repsNeeded(strength) return 3 + strength end
local baseReach = 10
function Catalog.reach(strength) return baseReach + 1.5 * strength end
Catalog.CastWindup = 0.26
Catalog.ReelTime = 1.22
Catalog.AimPeriod = 1.6
Catalog.AimTimeout = 15
local sectors = {
	{name = "Ближняя орбита", from = 0, bonus = 0, color = "A7ACFF"},
	{name = "Пояс астероидов", from = 14, bonus = 0.20, color = "76E4D9"},
	{name = "Внешняя орбита", from = 20, bonus = 0.48, color = "FFD391"},
	{name = "Дальний космос", from = 26, bonus = 0.85, color = "FFA8D4"},
}
function Catalog.sector(reach)
	for index = #sectors, 2, -1 do
		if reach >= sectors[index].from then return sectors[index] end
	end
	return sectors[1]
end
function Catalog.aimPower(elapsed)
	local phase = math.max(0, elapsed) % Catalog.AimPeriod / Catalog.AimPeriod
	return 1 - math.abs(2 * phase - 1)
end
function Catalog.aimBonus(power) return math.floor(5 * power + 0.5) end
function Catalog.castTime(reach) return 0.46 + (reach - baseReach) * 0.035 end
function Catalog.flightProgress(elapsed, reach)
	local phase = math.clamp((elapsed-Catalog.CastWindup)/Catalog.castTime(reach),0,1)
	return phase * phase * (3 - 2 * phase)
end
function Catalog.distanceLuck(reach)
	return 1 + math.max(0,reach-baseReach)/baseReach + Catalog.sector(reach).bonus
end

Catalog.GymTiers = {
	{name = "Тренажёр «Старт»", xp = 1, price = 0, color = "A7ACFF"},
	{name = "Тренажёр «Импульс»", xp = 2, price = 30, color = "76E4D9"},
	{name = "Тренажёр «Орбита»", xp = 3, price = 100, color = "FFD391"},
}

function Catalog.upgradeGym(data)
	local nextTier = Catalog.GymTiers[data.gymTier + 1]
	if not nextTier or data.cash < nextTier.price then return false end
	data.cash -= nextTier.price
	data.gymTier += 1
	return true
end

function Catalog.price(stat, level)
	if stat == "level" then return 24 + 18*level + 10*level*level end
	return 20 + 12*level + 8*level*level
end

function Catalog.rarityChances(level, reach)
	local result = {}
	local weight, previous = 0, 0
	local luck = Catalog.luck(level) * Catalog.distanceLuck(reach or baseReach)
	for tier, rarity in ipairs(Catalog.Rarities) do
		weight += rarity.weight
		local cumulative = (weight / 100) ^ luck
		result[tier] = cumulative - previous
		previous = cumulative
	end
	return result
end

function Catalog.chances(level, reach)
	local tiers = Catalog.rarityChances(level, reach)
	local chances = {}
	for i, planet in ipairs(Catalog.Planets) do
		chances[i] = tiers[planet.tier] / tierSizes[planet.tier]
	end
	return chances
end

function Catalog.roll(level, sample, reach)
	local chances = Catalog.chances(level, reach)
	local sum = 0
	for i,chance in ipairs(chances) do
		sum += chance
		if sample < sum then return i, chance end
	end
	return #chances, chances[#chances]
end

local function integer(value, maximum)
	if type(value) ~= "number" or value ~= value then return 0 end
	return math.clamp(math.floor(value), 0, maximum or 1e12)
end

function Catalog.inBag(data, id)
	local available = data.counts[id] or 0
	for _,item in ipairs(data.slots) do
		if item == id then available -= 1 end
	end
	return available
end

function Catalog.newProfile(old)
	old = old or {}
	local data = {
		cash = integer(old.cash or old.dust), level = integer(old.level,Catalog.MaxLevel),
		speed = integer(old.speed,Catalog.SpeedCap), strength = integer(old.strength,Catalog.StrengthCap),
		gymTier = math.max(1, integer(old.gymTier, #Catalog.GymTiers)),
		counts = {}, slots = table.create(Catalog.Slots,""),
	}
	data.reps = integer(old.reps,Catalog.repsNeeded(data.strength)-1)
	for _, planet in ipairs(Catalog.Planets) do
		data.counts[planet.id] = 0
	end
	for savedId, count in pairs(old.counts or {}) do
		local id = legacyIds[savedId] or savedId
		if Catalog.ById[id] then data.counts[id] += integer(count) end
	end
	for i=1,Catalog.Slots do
		local savedId = (old.slots or {})[i]
		local id = legacyIds[savedId] or savedId
		if Catalog.ById[id] and Catalog.inBag(data,id)>0 then data.slots[i]=id end
	end
	return data
end

function Catalog.income(data)
	local total = 0
	for _,id in ipairs(data.slots) do
		local planet = Catalog.ById[id]
		if planet then total += planet.rent end
	end
	return total
end

function Catalog.place(data, slot, id)
	if type(slot)~="number" or slot%1~=0 or slot<1 or slot>Catalog.Slots then return false end
	if id~="" and (type(id)~="string" or not Catalog.ById[id] or Catalog.inBag(data,id)<1) then return false end
	if data.slots[slot]==id then return false end
	data.slots[slot]=id
	return true
end

function Catalog.buy(data, stat)
	local cap = if stat=="level" then Catalog.MaxLevel elseif stat=="speed" then Catalog.SpeedCap else nil
	if not cap or data[stat]>=cap then return false end
	local price = Catalog.price(stat,data[stat])
	if data.cash<price then return false end
	data.cash-=price
	data[stat]+=1
	return true
end

function Catalog.train(data)
	if data.strength>=Catalog.StrengthCap then return false end
	data.reps += Catalog.GymTiers[data.gymTier].xp
	local needed = Catalog.repsNeeded(data.strength)
	if data.reps >= needed then
		data.strength += 1
		data.reps = if data.strength == Catalog.StrengthCap then 0 else data.reps - needed
	end
	return true
end

function Catalog.award(data,index)
	local planet=Catalog.Planets[index]
	data.counts[planet.id]=(data.counts[planet.id] or 0)+1
	data.cash+=planet.bounty
end

return Catalog
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="6">
      <Properties>
        <string name="Name">PlanetModel</string>
        <string name="Source"><![CDATA[local PlanetModel = {}

-- All dimensions below are relative to a unit sphere. Both scenes scale the finished model.
function PlanetModel.new(appearance, radius)
	local model = Instance.new("Model")
	local axis = CFrame.Angles(math.rad(16), 0, math.rad(appearance.tilt or 0))
	local function part(name, shape, size, frame, color)
		local p = Instance.new("Part")
		p.Name, p.Shape, p.Size, p.CFrame = name, shape, size, axis * frame
		p.Color, p.Material = Color3.fromHex(color), Enum.Material.SmoothPlastic
		p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true, false, false, false, false
		p.Parent = model
		return p
	end
	local ball = part("Surface", Enum.PartType.Ball, Vector3.one * 2, CFrame.identity, appearance.color)
	-- Pivot about the unrotated centre so PivotTo preserves the axial tilt.
	ball.PivotOffset = axis:Inverse()
	model.PrimaryPart = ball

	-- A shallow ellipsoid tangent to the globe, with local X pointing east.
	local function patch(name, latitude, longitude, width, height, color, lift)
		local lat, lon = math.rad(latitude), math.rad(longitude)
		local east = Vector3.new(math.cos(lon), 0, -math.sin(lon))
		local normal = Vector3.new(math.cos(lat)*math.sin(lon), math.sin(lat), math.cos(lat)*math.cos(lon))
		local frame = CFrame.fromMatrix(normal * (0.966 + (lift or 0)), east, normal:Cross(east), normal)
		part(name, Enum.PartType.Ball, Vector3.new(width, height, 0.11), frame, color)
	end
	for _, band in ipairs(appearance.bands or {}) do
		local lat = math.rad(band[1])
		local diameter = 2 * math.cos(lat) + 0.016
		local frame = CFrame.new(0, math.sin(lat), 0) * CFrame.Angles(0, 0, math.pi/2)
		part("Band", Enum.PartType.Cylinder, Vector3.new(band[2], diameter, diameter), frame, band[3])
	end
	for _, detail in ipairs(appearance.parts or {}) do
		local frame = CFrame.new(table.unpack(detail.position))
		if detail.rotation then
			local x, y, z = table.unpack(detail.rotation)
			frame *= CFrame.Angles(math.rad(x), math.rad(y), math.rad(z))
		end
		part(detail.name, Enum.PartType[detail.shape], Vector3.new(table.unpack(detail.size)), frame, detail.color)
	end
	for _, detail in ipairs(appearance.patches or {}) do
		patch("Marking", table.unpack(detail))
	end
	local craters = appearance.craters
	if craters then
		local rng = Random.new(craters.seed)
		for i = 1, craters.count do
			local latitude = math.deg(math.asin(1 - (i - 0.5) * 2 / craters.count))
			local longitude = i * 137.5
			local size = rng:NextNumber(0.12, 0.31)
			patch("CraterRim", latitude, longitude, size, size, craters.rim)
			patch("CraterFloor", latitude, longitude, size*0.72, size*0.72, craters.floor, 0.009)
		end
	end
	for _, ring in ipairs(appearance.rings or {}) do
		local segments = 36
		local length = 2 * ring.outer * math.tan(math.pi / segments)
		for i = 1, segments do
			local frame = CFrame.Angles(0, i * 2 * math.pi / segments, 0)
				* CFrame.new(0, 0, (ring.inner + ring.outer)/2)
			part("Ring", Enum.PartType.Block, Vector3.new(length, 0.025, ring.outer-ring.inner), frame, ring.color)
		end
	end
	model:ScaleTo(radius)
	return model
end

return PlanetModel
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="8">
      <Properties>
        <string name="Name">LunarStation</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local storage = game:GetService("ReplicatedStorage")
local Catalog = require(storage:WaitForChild("MoonCatalog"))
local Profiles = require(script.ProfileStore)
local Stations = require(script.Stations)
local Gym = require(script.Gym)
local event = Instance.new("RemoteEvent")
event.Name = "MoonStationEvent"
local sessions, hunting, aiming, loading = {}, {}, {}, {}
local rng = Random.new()
local sequence, pending, closing = 0,0,false

local function update(player)
	local s=sessions[player]
	event:FireClient(player,"profile",s.data,s.practice==true)
end
local function message(player,text)
	event:FireClient(player,"notice",text)
end
local function cancelAim(player)
	if not aiming[player] then return end
	aiming[player] = nil
	event:FireClient(player,"aim")
end
local function setSpeed(player)
	local session=sessions[player]
	local humanoid=player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if session and humanoid then humanoid.WalkSpeed=Catalog.walkSpeed(session.data.speed) end
end

-- Settle elapsed time at the old rate before changing an exhibit.
local function settle(s)
	local now=os.clock()
	local amount=s.fraction+(now-s.accruedAt)*Catalog.income(s.data)/Catalog.PayPeriod
	local dollars=math.floor(amount)
	s.fraction,s.accruedAt=amount-dollars,now
	s.data.cash+=dollars
	return dollars>0
end
local function endHunt(player,text,index)
	local round=hunting[player]
	hunting[player]=nil
	event:FireClient(player,"finish",text,index)
	if not round.reelStartedAt then event:FireAllClients("lassoEnd",player,round.id) end
end

local function syncLassos(player)
	for owner,round in pairs(hunting) do
		event:FireClient(player,"lasso",owner,round)
	end
end

local function inputGrace(player)
	return math.clamp(player:GetNetworkPing()+0.12,0.16,0.42)
end

local function complete(player,round)
	Catalog.award(sessions[player].data,round.index)
	local planet=Catalog.Planets[round.index]
	update(player)
	endHunt(player,"В рюкзаке теперь "..planet.name.."!   +$"..planet.bounty,round.index)
end

local function load(player)
	if closing or loading[player] or sessions[player] then return end
	loading[player]=true
	pending+=1
	local s=Profiles.open(player)
	if closing or player.Parent~=Players then
		if s then s:save(true) end
	elseif s then
		s.accruedAt,s.fraction,s.lastUse,s.lastSync=os.clock(),0,-10,-10
		sessions[player]=s
		Stations.assign(player)
		Stations.render(player,s.data)
		player.CharacterAdded:Connect(function(char)
			char:WaitForChild("Humanoid",10)
			setSpeed(player)
		end)
		player.CharacterRemoving:Connect(function()
			Gym.stop(player)
			cancelAim(player)
			if hunting[player] then endHunt(player,"Ловля завершена") end
		end)
		setSpeed(player)
		update(player)
		syncLassos(player)
	else
		player:Kick("Коллекция временно недоступна. Зайди через минуту.")
	end
	loading[player]=nil
	pending-=1
end

local function close(player)
	local s=sessions[player]
	Gym.stop(player)
	sessions[player],hunting[player],aiming[player]=nil,nil,nil
	Stations.remove(player)
	if s then
		pending+=1
		settle(s)
		if not s:save(true) then warn("Could not finish saving planet collection",player.UserId) end
		pending-=1
	end
end

local function useStation(player,key,slot)
	if type(key)~="string" or Gym.active(player) or aiming[player] or not Stations.near(player,key,slot) then return end
	if key=="Catch" then
		if hunting[player] then return end
		sequence+=1
		local aim={id=sequence,start=workspace:GetServerTimeNow()+0.2}
		aiming[player]=aim
		event:FireClient(player,"aim",aim)
	elseif not hunting[player] then
		event:FireClient(player,"menu",key,slot)
	end
end

local function startWorkout(player,s)
	if hunting[player] or aiming[player] or not Stations.near(player,"Gym") then return end
	if s.data.strength>=Catalog.StrengthCap then
		message(player,"Сила максимальная")
		return
	end
	local function rep()
		if closing or s.closed or not Stations.near(player,"Gym") then return false end
		local old=s.data.strength
		if not Catalog.train(s.data) then return false end
		update(player)
		if s.data.strength>old then
			message(player,string.format("Сила %d · дальность %g ст.",s.data.strength,Catalog.reach(s.data.strength)))
		end
		return s.data.strength<Catalog.StrengthCap
	end
	if not Gym.start(player,s.data.gymTier,rep,function()
		event:FireClient(player,"gym",true)
	end,function()
		event:FireClient(player,"gym",false)
	end) then message(player,"Тренажёр занят или персонаж уже сидит") end
end

local function cast(player,s,id,pressed)
	local aim=aiming[player]
	if not aim or aim.id~=id or type(pressed)~="number" or pressed~=pressed then return end
	if not Stations.near(player,"Catch") then cancelAim(player) return end
	local now=workspace:GetServerTimeNow()
	if pressed<aim.start or pressed>=aim.start+Catalog.AimTimeout or pressed<now-inputGrace(player) or pressed>now+0.06 then return end
	local root=player.Character:FindFirstChild("HumanoidRootPart")
	aiming[player]=nil
	local reach=Catalog.reach(s.data.strength)+Catalog.aimBonus(Catalog.aimPower(pressed-aim.start))
	local index,chance=Catalog.roll(s.data.level,rng:NextNumber(),reach)
	local round={
		id=aim.id,index=index,castAt=now,heading=root.CFrame.LookVector,
		reach=reach,chance=chance,luck=Catalog.luck(s.data.level),
		reelAt=now+Catalog.CastWindup+Catalog.castTime(reach)+0.65,
	}
	hunting[player]=round
	event:FireClient(player,"hunt",round)
	event:FireAllClients("lasso",player,round)
end

event.OnServerEvent:Connect(function(player,action,a,b)
	local s=sessions[player]
	if not s or s.closed or closing then return end
	if action=="gymStop" then Gym.stop(player) return end
	if action=="cast" then cast(player,s,a,b) return end
	if action=="cancel" then
		cancelAim(player)
		if hunting[player] and not hunting[player].reelStartedAt then endHunt(player,"Ловля отменена") end
		return
	end
	local now=os.clock()
	if action=="sync" then
		if now-s.lastSync<0.5 then return end
		s.lastSync=now
		update(player)
		if hunting[player] then event:FireClient(player,"hunt",hunting[player]) end
		if aiming[player] then event:FireClient(player,"aim",aiming[player]) end
		if Gym.active(player) then event:FireClient(player,"gym",true) end
		syncLassos(player)
		return
	end
	if now-s.lastUse<0.15 then return end
	s.lastUse=now
	if action=="gymStart" then startWorkout(player,s)
	elseif action=="gymUpgrade" and not Gym.active(player) and not hunting[player] and s.data.strength<Catalog.StrengthCap
		and Stations.near(player,"Gym") then
		local paid=settle(s)
		if Catalog.upgradeGym(s.data) then
			update(player)
			message(player,Catalog.GymTiers[s.data.gymTier].name.." · улучшено")
		elseif paid then update(player) end
	elseif action=="use" then useStation(player,a,b)
	elseif action=="buy" and (a=="Luck" or a=="Speed") and Stations.near(player,a) then
		local stat=if a=="Luck" then "level" else "speed"
		if Catalog.buy(s.data,stat) then
			setSpeed(player)
			update(player)
			message(player,if a=="Luck" then "Удача улучшена" else "Скорость бега увеличена")
		else message(player,"Проверь цену и уровень улучшения") end
	elseif action=="place" and type(a)=="number" and Stations.near(player,"Display",a) then
		local paid=settle(s)
		if Catalog.place(s.data,a,b) then
			Stations.render(player,s.data)
			update(player)
			message(player,if b=="" then "Планета возвращена в рюкзак" else "Планета выставлена")
		elseif paid then update(player) end
	end
end)
event.Parent=storage
Players.PlayerAdded:Connect(load)
Players.PlayerRemoving:Connect(close)
for _,player in ipairs(Players:GetPlayers()) do task.spawn(load,player) end

task.spawn(function()
	while not closing do
		task.wait(0.1)
		local now=workspace:GetServerTimeNow()
		for player,aim in pairs(aiming) do
			if now>aim.start+Catalog.AimTimeout or not Stations.near(player,"Catch") then cancelAim(player) end
		end
		for player,round in pairs(hunting) do
			if sessions[player].closed then
				endHunt(player,"Ловля завершена")
			elseif round.reelStartedAt then
				if now>=round.reelStartedAt+Catalog.ReelTime then complete(player,round) end
			elseif not Stations.near(player,"Catch") then
				endHunt(player,"Ловля завершена · вернись к телескопу")
			elseif now>=round.reelAt then
				round.reelStartedAt=now
				event:FireAllClients("lassoEnd",player,round.id,now)
			end
		end
	end
end)

task.spawn(function()
	while not closing do
		task.wait(1)
		for player,s in pairs(sessions) do
			if not s.closed and settle(s) then update(player) end
		end
	end
end)
task.spawn(function()
	while not closing do
		task.wait(50)
		for player,s in pairs(sessions) do
			task.spawn(function()
				if not s:save(false) then
					warn("Could not renew planet collection",player.UserId)
					if s.closed and player.Parent==Players then player:Kick("Коллекция открыта в другой сессии.") end
				end
			end)
		end
	end
end)
game:BindToClose(function()
	closing=true
	for player in pairs(table.clone(sessions)) do task.spawn(close,player) end
	while pending>0 do task.wait(0.1) end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">Gym</string>
          <string name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local Catalog = require(game.ReplicatedStorage.MoonCatalog)

local Gym = {}
local platform = workspace.Observatory.Stations:WaitForChild("Gym")
local origin = CFrame.new(platform.Position)
local machine = Instance.new("Model")
machine.Name = "ResistanceTrainer"
local function part(name, size, frame, color, shape, material)
	local piece = Instance.new("Part")
	piece.Name, piece.Size, piece.CFrame = name, size, origin * frame
	piece.Shape = shape or Enum.PartType.Block
	piece.Color, piece.Material = Color3.fromHex(color), material or Enum.Material.Metal
	piece.Anchored, piece.CanCollide, piece.CanTouch = true, false, false
	piece.Parent = machine
	return piece
end

part("BenchFoot", Vector3.new(3, 0.24, 2.8), CFrame.new(0, 0.48, 0.55), "293852")
part("BenchPost", Vector3.new(0.7, 0.85, 0.7), CFrame.new(0, 0.98, 0.6), "53637F")
part("SeatPad", Vector3.new(2.4, 0.25, 1.55), CFrame.new(0, 1.35, 0.7), "202B43")
part("BackPad", Vector3.new(2.15, 2, 0.22), CFrame.new(0, 2.22, 1.44), "202B43")
local accents = {}
for _, x in ipairs({-2.12, 2.12}) do
	part("Rail", Vector3.new(0.34, 3.9, 0.46), CFrame.new(x, 2.42, -0.76), "53637F")
	part("Counterweight", Vector3.new(0.8, 0.63, 0.63), CFrame.new(x, 3.29, -0.76), "374661", Enum.PartType.Cylinder)
	table.insert(accents, part("RailLight", Vector3.new(0.1, 2.3, 0.12), CFrame.new(x, 2.45, -0.5),
		Catalog.GymTiers[1].color, nil, Enum.Material.Neon))
end
local bar = part("LiftBar", Vector3.new(4.4, 0.19, 0.19), CFrame.new(0, 2.65, -0.76), "CDD5E1", Enum.PartType.Cylinder)
local rest = bar.CFrame
local raised = rest + Vector3.new(0, 0.96, -0.12)
local grips = {}
for side, x in pairs({Left = -0.95, Right = 0.95}) do
	local grip = part(side .. "Grip", Vector3.new(0.52, 0.28, 0.28), CFrame.new(x, 2.65, -0.76),
		"202B43", Enum.PartType.Cylinder)
	local weld = Instance.new("WeldConstraint")
	weld.Part0, weld.Part1, weld.Parent = bar, grip, grip
	grip.Anchored = false
	local target = Instance.new("Attachment")
	target.Parent = grip
	grips[side] = target
end

local seat = Instance.new("Seat")
seat.Name, seat.Size, seat.CFrame = "WorkoutSeat", Vector3.new(2.4, 0.25, 1.55), origin * CFrame.new(0, 1.35, 0.7)
seat.Transparency, seat.Anchored, seat.CanCollide, seat.CanTouch = 1, true, false, false
seat.Parent = machine
machine.Parent = platform

local workout
local function setColor(tier)
	local color = Color3.fromHex(Catalog.GymTiers[tier].color)
	for _, light in ipairs(accents) do light.Color = color end
end

function Gym.active(player)
	return workout ~= nil and workout.player == player
end

function Gym.stop(player)
	if not Gym.active(player) then return end
	local active = workout
	workout = nil
	if active.tween then active.tween:Cancel() end
	for _, control in ipairs(active.controls) do control:Destroy() end
	if seat.Occupant == active.humanoid then
		local weld = seat:FindFirstChild("SeatWeld")
		if weld then weld:Destroy() end
		active.humanoid.Sit = false
	end
	bar.CFrame = rest
	setColor(1)
	active.onStop()
end

function Gym.start(player, tier, onRep, onStart, onStop)
	if workout or seat.Occupant then return false end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 or humanoid.Sit then return false end
	local active = {player = player, humanoid = humanoid, controls = {}, onStop = onStop}
	workout = active
	seat:Sit(humanoid)
	task.spawn(function()
		local deadline = os.clock() + 0.6
		while workout == active and seat.Occupant ~= humanoid and os.clock() < deadline do task.wait() end
		if workout ~= active then return end
		if seat.Occupant ~= humanoid then
			Gym.stop(player)
			return
		end
		setColor(tier)
		for side, target in pairs(grips) do
			local upperArm = character:FindFirstChild(side .. "UpperArm")
			local hand = character:FindFirstChild(side .. "Hand")
			if upperArm and hand then
				local control = Instance.new("IKControl")
				control.Type, control.ChainRoot, control.EndEffector = Enum.IKControlType.Position, upperArm, hand
				control.Target, control.SmoothTime, control.Parent = target, 0.08, humanoid
				table.insert(active.controls, control)
			end
		end
		onStart()
		while workout == active and seat.Occupant == humanoid and humanoid.Health > 0 do
			for _, frame in ipairs({raised, rest}) do
				active.tween = TweenService:Create(bar, TweenInfo.new(0.58, Enum.EasingStyle.Sine), {CFrame = frame})
				active.tween:Play()
				active.tween.Completed:Wait()
				if workout ~= active then return end
				if seat.Occupant ~= humanoid or humanoid.Health <= 0 then
					Gym.stop(player)
					return
				end
			end
			if not onRep() then break end
		end
		if workout == active then Gym.stop(player) end
	end)
	return true
end

seat:GetPropertyChangedSignal("Occupant"):Connect(function()
	if workout and seat.Occupant ~= workout.humanoid and workout.tween then Gym.stop(workout.player) end
end)

return Gym
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Catalog = require(game.ReplicatedStorage.MoonCatalog)

local ProfileStore = {}
ProfileStore.__index = ProfileStore
local CURRENT_VERSION = 3
local LEASE_SECONDS = 180

function ProfileStore.open(player)
	local self = setmetatable({
		data = Catalog.newProfile(), key = "player_" .. player.UserId,
		token = HttpService:GenerateGUID(false), saving = false, closed = false,
	}, ProfileStore)
	-- Studio playtests use isolated session data, even if production API access is enabled.
	if RunService:IsStudio() then
		self.practice = true
		return self
	end
	for attempt = 1, 3 do
		local ok, record = pcall(function()
			self.store = DataStoreService:GetDataStore("CatchTheMoon_v1")
			return self.store:UpdateAsync(self.key, function(old)
				if old and old.version ~= 1 and old.version ~= 2 and old.version ~= CURRENT_VERSION then return nil end
				if old and old.owner and old.owner ~= self.token and old.expires > os.time() then return nil end
				return { version = CURRENT_VERSION, data = Catalog.newProfile(old and old.data),
					owner = self.token, expires = os.time() + LEASE_SECONDS }
			end)
		end)
		if ok and record and record.owner == self.token then
			self.data = record.data
			return self
		end
		if attempt < 3 then task.wait(2 * attempt) end
	end
	return nil
end

function ProfileStore:save(release)
	if self.saving and not release then return true end
	while self.saving do task.wait() end
	if self.practice or self.closed then return true end
	self.saving = true
	local snapshot = Catalog.newProfile(self.data)
	local attempts = if release then 3 else 1
	local success = false
	for attempt = 1, attempts do
		local ok, stored = pcall(function()
			return self.store:UpdateAsync(self.key, function(old)
				if not old or old.owner ~= self.token then return nil end
				return { version = CURRENT_VERSION, data = snapshot, owner = if release then nil else self.token,
					expires = if release then 0 else os.time() + LEASE_SECONDS }
			end)
		end)
		if ok then
			success = stored ~= nil
			self.closed = release or not success
			break
		end
		if attempt < attempts then task.wait(attempt) end
	end
	self.saving = false
	return success
end

return ProfileStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Stations</string>
          <string name="Source"><![CDATA[local Catalog = require(game.ReplicatedStorage.MoonCatalog)
local PlanetModel = require(game.ReplicatedStorage.PlanetModel)
local Stations = {}
local hub = workspace:WaitForChild("Observatory")
local static = hub:WaitForChild("Stations")
local gallery = Instance.new("Folder")
gallery.Name, gallery.Parent = "Gallery", hub
local plots, owners, floors = {}, {}, {}

local function block(parent,name,size,frame,color,material)
	local p=Instance.new("Part")
	p.Name,p.Size,p.CFrame=name,size,frame
	p.Color,p.Material=Color3.fromHex(color),material or Enum.Material.Metal
	p.Anchored,p.CanTouch,p.Parent=true,false,parent
	return p
end

local function sign(part,title,color,height)
	local board=Instance.new("BillboardGui")
	board.Name,board.Size,board.StudsOffset="Sign",UDim2.fromOffset(166,35),Vector3.new(0,height,0)
	board.AlwaysOnTop,board.MaxDistance,board.Parent=true,65,part
	local label=Instance.new("TextLabel")
	label.Size,label.BackgroundColor3,label.BackgroundTransparency=UDim2.fromScale(1,1),Color3.fromHex("152038"),0.12
	label.Font,label.TextSize,label.TextColor3=Enum.Font.GothamBold,15,Color3.fromHex(color)
	label.Text,label.Parent=title,board
	local corner=Instance.new("UICorner")
	corner.CornerRadius,corner.Parent=UDim.new(0,8),label
	return label
end

local function prompt(part,key,object,action,hold)
	local mount=Instance.new("Attachment")
	mount.Position=Vector3.new(0,0,0)
	mount.Parent=part
	local p=Instance.new("ProximityPrompt")
	p.Name,p.ObjectText,p.ActionText="StationPrompt",object,action
	p.HoldDuration,p.MaxActivationDistance,p.RequiresLineOfSight=hold or 0,10,false
	p:SetAttribute("MoonStation",key)
	p.Parent=mount
	return p
end

local labels={
	Catch={"Телескоп","Искать планету","F1CB88",7},
	Luck={"Удача","Улучшения","93E7CC",5.4},
	Speed={"Скорость","Улучшения","FFC299",5.6},
	Gym={"Тренажёр силы","Открыть тренировку","C1BDFF",6.8},
}
for key,info in pairs(labels) do
	local p=static:WaitForChild(key)
	sign(p,info[1],info[3],info[4])
	prompt(p,key,info[1],info[2])
end

local entry=block(gallery,"GalleryEntrance",Vector3.new(12,0.6,8),CFrame.new(0,1.15,33),"44526A")
sign(entry,"Галерея планет","EBD7AD",6)

function Stations.assign(player)
	local index=1
	while owners[index] do index+=1 end
	owners[index]=player
	local row=math.floor((index-1)/2)
	local z=43+18*row
	if not floors[row] then
		floors[row]=block(gallery,"GalleryDeck"..row,Vector3.new(46,1,18.1),CFrame.new(0,1,z),"384760",Enum.Material.Slate)
		for _,edge in ipairs({-22.8,22.8}) do
			block(gallery,"EdgeLight",Vector3.new(0.22,0.2,18),CFrame.new(edge,1.55,z),"BBA170",Enum.Material.Neon)
		end
	end
	local x=if index%2==1 then -11.5 else 11.5
	local model=Instance.new("Model")
	model.Name,model.Parent="Plot_"..player.UserId,gallery
	model:SetAttribute("OwnerId",player.UserId)
	local plaque=block(model,"Nameplate",Vector3.new(14,1,0.5),CFrame.new(x,2,z+4),"5B5160")
	sign(plaque,player.DisplayName,"FFE4B1",3)
	local plot={index=index,model=model,pads={}}
	plots[player]=plot
	for slot=1,Catalog.Slots do
		local pad=block(model,"Slot"..slot,Vector3.new(0.8,4.2,4.2),CFrame.new(x+(slot-2)*5.5,2,z)*CFrame.Angles(0,0,math.pi/2),"908069")
		pad.Shape=Enum.PartType.Cylinder
		local p=prompt(pad,"Display","Витрина "..slot,"Выбрать планету")
		p:SetAttribute("OwnerId",player.UserId)
		p:SetAttribute("Slot",slot)
		plot.pads[slot]=pad
	end
end

function Stations.render(player,data)
	local plot=plots[player]
	if not plot then return end
	for slot,pad in ipairs(plot.pads) do
		local id=data.slots[slot]
		if pad:GetAttribute("ItemId")==id then continue end
		pad:SetAttribute("ItemId",id)
		local previous=pad:FindFirstChild("Exhibit")
		if previous then previous:Destroy() end
		local planet=Catalog.ById[id]
		if planet then
			local exhibit = PlanetModel.new(planet.appearance, 1.35)
			exhibit.Name = "Exhibit"
			exhibit:PivotTo(CFrame.new(pad.Position + Vector3.yAxis*2.8) * CFrame.Angles(0, math.pi, 0))
			sign(exhibit.PrimaryPart, planet.name.."  ·  $"..planet.rent.."/5 с", planet.appearance.color, 2.4).Parent.MaxDistance=18
			exhibit.Parent = pad
		end
	end
end

function Stations.near(player,key,slot)
	local char=player.Character
	local root=char and char:FindFirstChild("HumanoidRootPart")
	local humanoid=char and char:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health<=0 then return false end
	local part
	if key=="Display" then
		part=plots[player] and plots[player].pads[slot]
	elseif labels[key] then
		part=static:FindFirstChild(key)
	end
	return part~=nil and (root.Position-part.Position).Magnitude<=12
end

function Stations.remove(player)
	local plot=plots[player]
	if plot then
		plot.model:Destroy()
		owners[plot.index],plots[player]=nil,nil
	end
end
return Stations
]]></string>
        </Properties>
      </Item>
