      <Item class="ModuleScript" referent="109">
        <Properties>
          <string name="Name">SlotAppearance</string>
          <string name="Source"><![CDATA[-- Server-side presentation hook. Ownership, price and authorization belong to the caller.
local SlotAppearance={}
function SlotAppearance.setUnlocked(slot,unlocked)
	assert(type(unlocked)=="boolean","Expected unlocked state")
	slot.Halo.Material=if unlocked then Enum.Material.Neon else Enum.Material.Metal
	slot.Halo.Color=Color3.fromHex(if unlocked then "77DAD5" else "5D7386")
	slot.Emitter.Color=Color3.fromHex(if unlocked then "739CAC" else "374A60")
	slot.LockBar.Transparency=if unlocked then 1 else 0
	slot:SetAttribute("Unlocked",unlocked)
end
return SlotAppearance
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="110">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="111">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="112">
        <Properties>
          <string name="Name">LunarStation</string>
          <string name="Source"><![CDATA[local Players=game:GetService("Players")
local RunService=game:GetService("RunService")
local Actions=game:GetService("ContextActionService")
local Prompts=game:GetService("ProximityPromptService")
local Input=game:GetService("UserInputService")
local GuiService=game:GetService("GuiService")
local storage=game:GetService("ReplicatedStorage")
local Catalog=require(storage:WaitForChild("MoonCatalog"))
local player=Players.LocalPlayer
local ui=require(script:WaitForChild("Interface")).new(player:WaitForChild("PlayerGui"))
local scene=require(script:WaitForChild("MoonScene")).new()
local event=storage:WaitForChild("MoonStationEvent")
local encounter
local aim, lastCast, showingFlight=nil,-math.huge,false

Prompts.PromptShown:Connect(function(prompt)
	local owner=prompt:GetAttribute("OwnerId")
	if owner and owner~=player.UserId then prompt.Enabled=false end
end)
Prompts.PromptTriggered:Connect(function(prompt,who)
	local key=prompt:GetAttribute("MoonStation")
	if (who and who~=player) or not key or not ui.data or ui.overlay.Visible or aim or encounter or ui.workout.Visible then return end
	local owner=prompt:GetAttribute("OwnerId")
	if owner and owner~=player.UserId then return end
	event:FireServer("use",key,prompt:GetAttribute("Slot"))
end)

local function cast()
	if not aim then return end
	local now=workspace:GetServerTimeNow()
	if now>=aim.start and now-lastCast>=0.25 then
		lastCast=now
		event:FireServer("cast",aim.id,now)
	end
end
ui.cast.Activated:Connect(cast)
ui.cancel.Activated:Connect(function() event:FireServer("cancel") end)
ui.bag.Activated:Connect(function() if ui.data and not aim and not encounter and not ui.workout.Visible then ui:menu("Bag") end end)
ui.startWorkout.Activated:Connect(function()
	if ui.mode=="Gym" and ui.data.strength<Catalog.StrengthCap then event:FireServer("gymStart") end
end)
ui.stopWorkout.Activated:Connect(function() event:FireServer("gymStop") end)
ui.close.Activated:Connect(function() ui:menu(nil) end)
ui.confirm.Activated:Connect(function()
	if not ui.canConfirm then return end
	if ui.mode=="Display" then event:FireServer("place",ui.slot,"")
	elseif ui.mode=="Luck" or ui.mode=="Speed" then event:FireServer("buy",ui.mode)
	elseif ui.mode=="Gym" then event:FireServer("gymUpgrade") end
end)
for i,row in ipairs(ui.rows) do
	row.button.Activated:Connect(function()
		local id=Catalog.Planets[i].id
		if ui.mode=="Display" and Catalog.inBag(ui.data,id)>0 then event:FireServer("place",ui.slot,id) end
	end)
end
Actions:BindActionAtPriority("CastLasso",function(_,state)
	if not aim or ui.overlay.Visible or Input:GetFocusedTextBox() then return Enum.ContextActionResult.Pass end
	if state==Enum.UserInputState.Begin then cast() end
	return Enum.ContextActionResult.Sink
end,false,Enum.ContextActionPriority.High.Value,Enum.KeyCode.Space,Enum.KeyCode.ButtonR2)

RunService.RenderStepped:Connect(function()
	local now=workspace:GetServerTimeNow()
	if aim and ui.data then
		local power=Catalog.aimPower(now-aim.start)
		ui:aim(power,Catalog.reach(ui.data.strength)+Catalog.aimBonus(power))
	elseif encounter then
		local progress=Catalog.flightProgress(now-encounter.castAt,encounter.reach)
		if progress<1 then
			ui:flight(progress,encounter.reach,encounter.luck)
		elseif showingFlight then
			showingFlight=false
			ui:hunt(encounter)
		end
	end
	if ui.overlay.Visible and ui.mode~="Bag" then
		local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		local target
		if ui.mode=="Display" then
			local gallery=workspace.Observatory:FindFirstChild("Gallery")
			local plot=gallery and gallery:FindFirstChild("Plot_"..player.UserId)
			target=plot and plot:FindFirstChild("Slot"..ui.slot)
		else target=workspace.Observatory.Stations:FindFirstChild(ui.mode) end
		if not root or not target or (root.Position-target.Position).Magnitude>12 then ui:menu(nil) end
	end
end)

event.OnClientEvent:Connect(function(kind,a,b,c)
	if kind=="profile" then
		local first=ui.data==nil
		ui.data=a
		ui:refresh()
		if first then ui:notice("Поймай планету! Подойди к телескопу в центре.") end
	elseif kind=="aim" then
		aim=a
		if a then ui:menu(nil) else ui:hunt(nil) end
		ui.bag.Visible=not a and not encounter
	elseif kind=="hunt" then
		local new=not encounter or encounter.id~=a.id
		aim=nil
		if new then
			ui:menu(nil)
		end
		encounter=a
		ui.bag.Visible=false
		showingFlight=Catalog.flightProgress(workspace:GetServerTimeNow()-a.castAt,a.reach)<1
		if not showingFlight then ui:hunt(a) end
	elseif kind=="finish" then
		encounter=nil
		showingFlight=false
		ui.bag.Visible=true
		ui:hunt(nil)
		ui:notice(a)
	elseif kind=="lasso" then scene:progress(a,b)
	elseif kind=="lassoEnd" then scene:finish(a,b,c)
	elseif kind=="gym" then
		if a then ui:menu(nil) end
		ui.workout.Visible, ui.bag.Visible = a, not a and not encounter
		if a and Input.PreferredInput==Enum.PreferredInput.Gamepad then
			GuiService.SelectedObject=ui.stopWorkout
		elseif not a and GuiService.SelectedObject==ui.stopWorkout then
			GuiService.SelectedObject=nil
		end
	elseif kind=="menu" then
		ui:menu(a,b)
		if a=="Gym" and Input.PreferredInput==Enum.PreferredInput.Gamepad then GuiService.SelectedObject=ui.startWorkout end
	elseif kind=="notice" then ui:notice(a) end
end)
event:FireServer("sync")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="113">
          <Properties>
            <string name="Name">Interface</string>
            <string name="Source"><![CDATA[local Catalog = require(game.ReplicatedStorage:WaitForChild("MoonCatalog"))
local Interface = {}
Interface.__index = Interface

local ink, panel, line = Color3.fromHex("11182B"), Color3.fromHex("202B43"), Color3.fromHex("53637F")
local paper, muted, gold = Color3.fromHex("F2EFE6"), Color3.fromHex("B5C4DD"), Color3.fromHex("FFD391")
local function box(class, parent, name, size, pos, color)
	local o = Instance.new(class)
	o.Name, o.Size, o.Position = name, size, pos
	o.BorderSizePixel = 0
	o.BackgroundColor3 = color or ink
	o.BackgroundTransparency = if color then 0 else 1
	o.Parent = parent
	return o
end
local function shape(o, radius, border)
	local corner = Instance.new("UICorner")
	corner.CornerRadius, corner.Parent = UDim.new(0,radius), o
	if border then
		local s = Instance.new("UIStroke")
		s.Color, s.Transparency, s.ApplyStrokeMode, s.Parent = border, 0.2, Enum.ApplyStrokeMode.Border, o
	end
end
local function label(parent, name, value, size, pos, textSize, color, font)
	local o = box("TextLabel",parent,name,size,pos)
	o.Text, o.TextSize, o.TextColor3 = value,textSize,color or paper
	o.Font = font or Enum.Font.GothamMedium
	o.TextXAlignment = Enum.TextXAlignment.Left
	return o
end
local function button(parent,name,value,size,pos,color)
	local o = box("TextButton",parent,name,size,pos,color or panel)
	o.Text, o.TextSize, o.Font = value,16,Enum.Font.GothamBold
	o.TextColor3 = if color == gold then ink else paper
	o.AutoButtonColor = true
	shape(o,10,if color == gold then nil else line)
	return o
end
local function fit(o, maxWidth, maxHeight)
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize, limit.Parent = Vector2.new(maxWidth,maxHeight), o
end

function Interface.new(parent)
	local self=setmetatable({rows={}},Interface)
	local gui=Instance.new("ScreenGui")
	gui.Name,gui.ResetOnSpawn,gui.DisplayOrder="MoonStation",false,3
	gui.ZIndexBehavior,gui.Parent=Enum.ZIndexBehavior.Sibling,parent
	local header=box("Frame",gui,"Status",UDim2.new(1,-24,0,56),UDim2.fromOffset(12,5))
	local balance=box("Frame",header,"Wallet",UDim2.fromOffset(174,49),UDim2.fromOffset(0,0),ink)
	shape(balance,10,line)
	self.cash=label(balance,"Cash","$0",UDim2.fromOffset(150,24),UDim2.fromOffset(11,2),20,gold,Enum.Font.GothamBold)
	self.rate=label(balance,"Income","Витрины  +$0 / 5 с",UDim2.fromOffset(158,19),UDim2.fromOffset(11,26),12,muted)
	self.bag=button(gui,"Bag","Рюкзак",UDim2.fromOffset(104,44),UDim2.new(0.5,0,1,-12))
	self.bag.AnchorPoint=Vector2.new(0.5,1)

	self.toast=label(gui,"Notice","",UDim2.new(1,-28,0,44),UDim2.new(0.5,0,0,62),15,paper)
	self.toast.AnchorPoint=Vector2.new(0.5,0)
	self.toast.TextXAlignment=Enum.TextXAlignment.Center
	self.toast.BackgroundColor3,self.toast.BackgroundTransparency,self.toast.TextWrapped=ink,0.1,true
	fit(self.toast,450,44)
	shape(self.toast,10)
	self.toast.Visible=false

	local dock=box("Frame",gui,"Capture",UDim2.new(1,-20,0,122),UDim2.new(0.5,0,1,-10),ink)
	dock.AnchorPoint,dock.Visible=Vector2.new(0.5,1),false
	shape(dock,14,line)
	fit(dock,506,124)
	self.dock=dock
	self.target=label(dock,"Target","",UDim2.new(1,-92,0,23),UDim2.fromOffset(13,6),16,paper,Enum.Font.GothamBold)
	self.progress=label(dock,"Progress","",UDim2.fromOffset(70,22),UDim2.new(1,-83,0,7),15,gold)
	self.progress.TextXAlignment=Enum.TextXAlignment.Right
	self.hint=label(dock,"Hint","",UDim2.new(1,-20,0,18),UDim2.fromOffset(13,28),12,muted)
	local bar=box("Frame",dock,"Track",UDim2.new(1,-28,0,13),UDim2.fromOffset(14,51),panel)
	shape(bar,5)
	self.track = bar
	self.powerColors = Instance.new("UIGradient")
	self.powerColors.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0,Color3.fromHex("FF948E")),
		ColorSequenceKeypoint.new(0.5,Color3.fromHex("FFD391")),
		ColorSequenceKeypoint.new(1,Color3.fromHex("84DBBB")),
	})
	self.powerColors.Enabled,self.powerColors.Parent = false,bar
	self.marker=box("Frame",bar,"Pointer",UDim2.fromOffset(4,23),UDim2.fromScale(0,0.5),paper)
	self.marker.AnchorPoint=Vector2.new(0.5,0.5)
	self.cast=button(dock,"Cast","Бросить",UDim2.new(0.72,-16,0,40),UDim2.fromOffset(13,74),gold)
	self.cancel=button(dock,"Cancel","Выйти",UDim2.new(0.28,-14,0,40),UDim2.new(0.72,1,0,74))

	local gym = box("Frame",gui,"Workout",UDim2.new(1,-20,0,116),UDim2.new(0.5,0,1,-10),ink)
	gym.AnchorPoint,gym.Visible = Vector2.new(0.5,1),false
	fit(gym,410,116)
	shape(gym,14,line)
	self.workout = gym
	self.gymTitle = label(gym,"Trainer","",UDim2.new(1,-24,0,23),UDim2.fromOffset(12,5),16,paper,Enum.Font.GothamBold)
	self.gymProgress = label(gym,"Progress","",UDim2.new(1,-24,0,18),UDim2.fromOffset(12,29),13,muted)
	local xpTrack = box("Frame",gym,"Track",UDim2.new(1,-24,0,8),UDim2.fromOffset(12,52),panel)
	shape(xpTrack,4)
	self.gymFill = box("Frame",xpTrack,"Fill",UDim2.fromScale(0,1),UDim2.fromOffset(0,0),gold)
	shape(self.gymFill,4)
	self.stopWorkout = button(gym,"Stop","Стоп",UDim2.new(1,-24,0,44),UDim2.fromOffset(12,65))

	local shade=box("TextButton",gui,"Backdrop",UDim2.fromScale(1,1),UDim2.fromOffset(0,0),ink)
	shade.Text,shade.AutoButtonColor,shade.BackgroundTransparency="",false,0.28
	shade.Visible,shade.ZIndex=false,10
	self.overlay=shade
	local sheet=box("Frame",shade,"Sheet",UDim2.new(1,-22,1,-16),UDim2.fromScale(0.5,0.5),ink)
	sheet.AnchorPoint,sheet.Active=Vector2.new(0.5,0.5),true
	fit(sheet,472,450)
	shape(sheet,15,line)
	self.heading=label(sheet,"Title","",UDim2.new(1,-70,0,30),UDim2.fromOffset(16,10),23,paper,Enum.Font.GothamBold)
	self.close=button(sheet,"Close","×",UDim2.fromOffset(44,44),UDim2.new(1,-52,0,4))
	self.summary=label(sheet,"Summary","",UDim2.new(1,-32,0,29),UDim2.fromOffset(16,43),13,muted)
	self.summary.TextWrapped=true
	local list=box("ScrollingFrame",sheet,"Items",UDim2.new(1,-24,1,-138),UDim2.fromOffset(12,74))
	list.ScrollingDirection=Enum.ScrollingDirection.Y
	list.Active=true
	list.ScrollBarThickness,list.ScrollBarImageColor3=6,line
	self.list=list
	for i,planet in ipairs(Catalog.Planets) do
		local b=button(list,planet.id,"",UDim2.new(1,-7,0,49),UDim2.fromOffset(0,(i-1)*55))
		local swatch=box("Frame",b,"Sample",UDim2.fromOffset(21,21),UDim2.fromOffset(10,3),Color3.fromHex(planet.appearance.color))
		shape(swatch,13)
		local shading=Instance.new("UIGradient")
		shading.Color=ColorSequence.new(Color3.new(1,1,1), Color3.fromHex("737D98"))
		shading.Rotation,shading.Parent=55,swatch
		label(b,"Name",planet.name,UDim2.new(1,-111,0,22),UDim2.fromOffset(44,3),15,paper,Enum.Font.GothamBold)
		local note=label(b,"Detail","",UDim2.new(1,-18,0,19),UDim2.fromOffset(10,26),12,muted)
		local qty=label(b,"Quantity","",UDim2.fromOffset(62,20),UDim2.new(1,-70,0,4),14,Color3.fromHex(planet.appearance.color))
		qty.TextXAlignment=Enum.TextXAlignment.Right
		self.rows[i]={button=b,note=note,qty=qty}
	end
	self.info=label(list,"UpgradeDetails","",UDim2.new(1,-14,0,95),UDim2.fromOffset(8,4),18,paper)
	self.info.TextWrapped=true
	self.confirm=button(sheet,"Confirm","",UDim2.new(1,-24,0,43),UDim2.new(0,12,1,-53),gold)
	self.startWorkout = button(sheet,"StartWorkout","Тренироваться",UDim2.new(0.5,-15,0,44),UDim2.new(0,12,1,-53),gold)
	self.startWorkout.Visible = false
	return self
end

function Interface:notice(text)
	self.toast.Text=text
	self.toast.Visible=true
	self.noticeId=(self.noticeId or 0)+1
	local id=self.noticeId
	task.delay(4,function() if self.noticeId==id then self.toast.Visible=false end end)
end

function Interface:menu(mode,slot)
	self.mode,self.slot=mode,slot
	self.overlay.Visible=mode~=nil
	self.list.CanvasPosition=Vector2.zero
	self:refresh()
end

function Interface:refresh()
	local d=self.data
	if not d then return end
	self.cash.Text="$"..d.cash
	self.rate.Text=string.format("Витрины   +$%d / 5 с",Catalog.income(d))
	local gymTier = Catalog.GymTiers[d.gymTier]
	local maxStrength = d.strength >= Catalog.StrengthCap
	local needed = Catalog.repsNeeded(d.strength)
	local reach = Catalog.reach(d.strength)
	self.gymTitle.Text = gymTier.name
	self.gymProgress.Text = if maxStrength then "Максимальная сила"
		else string.format("Сила %d  ·  %d / %d XP  ·  +%d за повтор",d.strength,d.reps,needed,gymTier.xp)
	self.gymFill.Size = UDim2.fromScale(if maxStrength then 1 else d.reps/needed,1)
	self.gymFill.BackgroundColor3 = Color3.fromHex(gymTier.color)
	self.startWorkout.Visible = self.mode=="Gym"
	if not self.mode then return end
	local exhibition=self.mode=="Display"
	local gym=self.mode=="Gym"
	local shop=gym or self.mode=="Luck" or self.mode=="Speed"
	local stat=if self.mode=="Luck" then "level" else "speed"
	local chances=Catalog.chances(d.level,reach)
	local equipped=exhibition and Catalog.ById[d.slots[self.slot]]
	self.heading.Text=if exhibition then "Витрина "..self.slot elseif self.mode=="Luck" then "Мастерская удачи"
		elseif gym then "Тренажёр силы" elseif shop then "Скорость бега" else "Рюкзак планет"
	self.summary.Text=if exhibition then (if equipped then "На витрине — "..equipped.name..". Выбери замену." else "Выбери планету для витрины")
		elseif gym then self.gymProgress.Text
		else string.format("Шансы без бонуса за бросок · Дальность %g–%g ст.",reach,reach+Catalog.aimBonus(1))
	self.info.Visible=shop
	self.list.Size=UDim2.new(1,-24,1,if shop or exhibition then -138 else -84)
	self.list.CanvasSize=UDim2.fromOffset(0,if shop then 106 else #self.rows*55)
	for i,row in ipairs(self.rows) do
		local planet=Catalog.Planets[i]
		local bag=Catalog.inBag(d,planet.id)
		row.button.Visible=not shop
		row.button.AutoButtonColor=exhibition and bag>0
		row.qty.Text="×"..bag
		row.note.Text=string.format("%s · %.2f%% · $%d/5 с",planet.rarity,chances[i]*100,planet.rent)
	end
	self.confirm.Visible=shop or exhibition
	self.confirm.Position=if gym then UDim2.new(0.5,3,1,-53) else UDim2.new(0,12,1,-53)
	self.confirm.Size=if gym then UDim2.new(0.5,-15,0,44) else UDim2.new(1,-24,0,43)
	local enabled=false
	if gym then
		local nextTier = Catalog.GymTiers[d.gymTier+1]
		self.info.Text = string.format("%s\nДальность %g–%g ст.\nДальние секторы повышают удачу",gymTier.name,reach,reach+Catalog.aimBonus(1))
		if nextTier then self.info.Text ..= string.format("\nСледующий тренажёр даёт +%d XP",nextTier.xp) end
		self.startWorkout.Text = if maxStrength then "Сила максимальна" else "Тренироваться"
		self.startWorkout.Active, self.startWorkout.AutoButtonColor = not maxStrength, not maxStrength
		self.startWorkout.BackgroundColor3 = if maxStrength then panel else gold
		self.startWorkout.TextColor3 = if maxStrength then muted else ink
		enabled = nextTier ~= nil and not maxStrength and d.cash >= nextTier.price
		self.confirm.Text = if nextTier and not maxStrength then "Улучшить · $"..nextTier.price else "Улучшения завершены"
	elseif shop then
		local level=d[stat]
		local capped=level>=(if stat=="level" then Catalog.MaxLevel else Catalog.SpeedCap)
		local nextLevel=if capped then level else level+1
		local price=Catalog.price(stat,level)
		self.info.Text=if stat=="level" then string.format("Удача ×%.2f → ×%.2f\nШанс легендарной %.2f%% → %.2f%%",Catalog.luck(level),Catalog.luck(nextLevel),Catalog.rarityChances(level,reach)[#Catalog.Rarities]*100,Catalog.rarityChances(nextLevel,reach)[#Catalog.Rarities]*100)
			else string.format("Скорость %d → %d\nстудов в секунду",Catalog.walkSpeed(level),Catalog.walkSpeed(nextLevel))
		enabled=not capped and d.cash>=price
		self.confirm.Text=if capped then "Максимальный уровень" elseif enabled then "Улучшить за $"..price else "Цена $"..price.."  ·  Нужно ещё $"..(price-d.cash)
	elseif exhibition then
		enabled=equipped~=nil
		self.confirm.Text=if enabled then "Вернуть планету в рюкзак" else "Витрина свободна"
	end
	self.confirm.AutoButtonColor=enabled
	self.confirm.BackgroundColor3=if enabled then gold else panel
	self.confirm.TextColor3=if enabled then ink else muted
	self.canConfirm=enabled
end

function Interface:hunt(packet)
	self.dock.Visible=packet~=nil
	if not packet then return end
	self.dock.Size=UDim2.new(1,-20,0,63)
	self.track.Visible,self.cast.Visible,self.cancel.Visible=false,false,false
	local planet=Catalog.Planets[packet.index]
	self.target.Text=string.format("%s · %s",planet.name,planet.rarity)
	self.progress.Text=string.format("%.2f%%",packet.chance*100)
	self.hint.Text=string.format("Подтягиваем планету · 1 к %d",math.floor(1/packet.chance+0.5))
	self.hint.TextColor3=muted
end

function Interface:aim(power,reach)
	self.dock.Visible=true
	self.dock.Size=UDim2.new(1,-20,0,122)
	self.track.Visible,self.cast.Visible,self.cancel.Visible=true,true,true
	self.track.BackgroundColor3,self.powerColors.Enabled=paper,true
	self.target.Text="Дальность броска"
	self.progress.Text=string.format("%g ст.",reach)
	self.hint.Text,self.hint.TextColor3="Брось, когда указатель справа",muted
	self.marker.Position=UDim2.fromScale(power,0.5)
end

function Interface:flight(progress,reach,luck)
	local travelled=reach*progress
	local sector=Catalog.sector(travelled)
	self.dock.Visible=true
	self.dock.Size=UDim2.new(1,-20,0,73)
	self.track.Visible,self.cast.Visible,self.cancel.Visible=true,false,false
	self.track.BackgroundColor3,self.powerColors.Enabled=panel,false
	self.target.Text=sector.name
	self.progress.Text=string.format("%.0f ст.",travelled)
	self.hint.Text=string.format("Удача ×%.2f",luck*Catalog.distanceLuck(travelled))
	self.hint.TextColor3=Color3.fromHex(sector.color)
	self.marker.Position=UDim2.fromScale(progress,0.5)
end
return Interface
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="114">
          <Properties>
            <string name="Name">Lasso</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local VRService = game:GetService("VRService")
local Impact = require(script.Parent:WaitForChild("LassoImpact"))
local PullPose = require(script.Parent:WaitForChild("PullPose"))
local Lasso = {}
Lasso.__index = Lasso

local Catalog = require(game.ReplicatedStorage:WaitForChild("MoonCatalog"))
local windup = Catalog.CastWindup
local reelTime = Catalog.ReelTime
local catchDuration = 1.9
local gold = Color3.fromHex("FFD78A")
local pearl = Color3.fromHex("FFF2D6")
local ropeColor = ColorSequence.new(gold, pearl)
local cold = Color3.fromHex("69F4FF")

local function ease(t)
	t = math.clamp(t, 0, 1)
	return t*t*(3-2*t)
end

local function beam(parent, from, to, width)
	local line = Instance.new("Beam")
	line.Attachment0, line.Attachment1 = from, to
	line.Width0, line.Width1 = width, width
	line.Color, line.LightEmission = ropeColor, 1
	line.FaceCamera, line.Segments = true, 10
	line.Parent = parent
	return line
end

function Lasso.new(owner, packet, moon)
	local flat = Vector3.new(packet.heading.X, 0, packet.heading.Z)
	local facing = if flat.Magnitude > 0.01 then flat.Unit else -Vector3.zAxis
	local self = setmetatable({
		id = packet.id, owner = owner, moon = moon, castAt = packet.castAt, baseScale = moon:GetScale(),
		orientation = CFrame.lookAt(Vector3.zero, facing), reelStartedAt = packet.reelStartedAt,
		loadedAt = os.clock(), nextEcho = 0, reach = packet.reach, castTime = Catalog.castTime(packet.reach),
		nodes = {}, arcs = {},
	}, Lasso)

	local rig = Instance.new("Part")
	rig.Name, rig.Size, rig.Transparency = "LassoLoop", Vector3.one*0.1, 1
	rig.Anchored, rig.CanCollide, rig.CanTouch, rig.CanQuery, rig.CastShadow = true, false, false, false
	self.rig = rig
	for i = 1, 4 do
		local node = Instance.new("Attachment")
		node.Parent = rig
		self.nodes[i] = node
	end
	for i, node in ipairs(self.nodes) do
		self.arcs[i] = beam(rig, node, self.nodes[i%4+1], 0.105)
	end

	local surface = moon.PrimaryPart
	local outline = Instance.new("Highlight")
	outline.Name, outline.Adornee, outline.DepthMode = "InkOutline",moon,Enum.HighlightDepthMode.Occluded
	outline.FillTransparency, outline.OutlineTransparency = 1,0.14
	outline.OutlineColor, outline.Parent = Color3.fromHex("493D66"),moon
	self.outline = outline
	local left, right = Instance.new("Attachment"), Instance.new("Attachment")
	left.Position, right.Position = Vector3.new(-1.1,0,0), Vector3.new(1.1,0,0)
	left.Parent, right.Parent = surface, surface
	local trail = Instance.new("Trail")
	trail.Name, trail.Attachment0, trail.Attachment1 = "Stardust", left, right
	trail.Lifetime, trail.MinLength, trail.FaceCamera, trail.LightEmission = 0.48, 0.06, true, 1
	trail.Color = ColorSequence.new(surface.Color, pearl)
	trail.Transparency = NumberSequence.new(0.3, 1)
	trail.WidthScale = NumberSequence.new(1, 0)
	trail.Parent = surface

	local sparks = Instance.new("ParticleEmitter")
	sparks.Texture = "rbxasset://textures/particles/sparkles_main.dds"
	sparks.Rate, sparks.Lifetime, sparks.Speed = 0, NumberRange.new(0.25,0.48), NumberRange.new(2,5)
	sparks.Color, sparks.LightEmission, sparks.SpreadAngle = ropeColor, 1, Vector2.new(180,180)
	sparks.Size = NumberSequence.new(0.26, 0)
	sparks.Parent = rig
	self.sparks = sparks
	local comet = Instance.new("Part")
	comet.Name, comet.Material, comet.Color = "LassoComet", Enum.Material.Neon, cold
	comet.Anchored,comet.CanCollide,comet.CanQuery,comet.CanTouch,comet.CastShadow = true,false,false,false,false
	comet.Size,comet.Transparency,comet.Parent = Vector3.new(0.18,0.18,1.4),1,rig
	self.comet = comet
	if owner==Players.LocalPlayer then
		local gui = Instance.new("ScreenGui")
		gui.Name,gui.DisplayOrder,gui.IgnoreGuiInset,gui.ResetOnSpawn = "LassoSpeedLines",2,true,false
		gui.Parent = owner:FindFirstChildOfClass("PlayerGui")
		self.gui = gui
	end
	return self
end

function Lasso:bindHand()
	local char = self.owner.Character
	if not char then return false end
	local hand = char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")
	local root = char:FindFirstChild("HumanoidRootPart")
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	if not hand or not root or not humanoid then return false end
	self.character, self.root = char, root
	local grip = Instance.new("Attachment")
	local handle = hand:FindFirstChild("RightGripAttachment")
	grip.Position = if handle then handle.Position else Vector3.new(0,-hand.Size.Y*0.45,0)
	grip.Name, grip.Parent = "LassoGrip", hand
	self.grip = grip
	self.rope = beam(self.rig, grip, self.nodes[1], 0.085)
	local function bindLeft()
		local left = char:FindFirstChild("LeftHand") or char:FindFirstChild("Left Arm")
		if self.leftGrip or not left then return end
		local handle = left:FindFirstChild("LeftGripAttachment")
		local contact = Instance.new("Attachment")
		contact.Position = if handle then handle.Position else Vector3.new(0,-left.Size.Y*0.45,0)
		contact.Name,contact.Parent = "LassoFrontGrip",left
		self.leftGrip = contact
		self.between = beam(self.rig,grip,contact,0.085)
		self.between.Enabled = false
	end
	bindLeft()
	self.handAdded = char.ChildAdded:Connect(bindLeft)
	self.pose = PullPose.new(self,humanoid)
	self.rig.Parent = workspace
	return true
end

function Lasso:impact(kind,position)
	Impact.burst(self.rig,kind,position)
	Impact.screen(self.gui,kind)
end

function Lasso:finish(reelStartedAt)
	if self.endedAt then return end
	self.endedAt, self.caught = reelStartedAt or workspace:GetServerTimeNow(), reelStartedAt~=nil
	self.endPosition = self.position
	self.endScale = self.scale or 0.5
	local camera = workspace.CurrentCamera
	if self.caught and self.gui and self.root and camera and camera.CameraType==Enum.CameraType.Custom
		and not GuiService.ReducedMotionEnabled and not VRService.VREnabled then
		self.camera,self.wide,self.focus = camera,camera.CFrame,camera.Focus
		self.cameraOrigin = self.root.Position
		self.cameraFilter = RaycastParams.new()
		self.cameraFilter.FilterDescendantsInstances = {self.character,self.moon,self.rig}
		camera.CameraType = Enum.CameraType.Scriptable
	end
end

function Lasso:updateCloseup(palm,elapsed)
	local camera = self.camera
	if not camera or camera~=workspace.CurrentCamera or camera.CameraType~=Enum.CameraType.Scriptable then return end
	local offset = self.root.Position-self.cameraOrigin
	local wide = self.wide+offset
	local release = ease((elapsed-0.75)/0.5)
	local focus = self.root.Position:Lerp(palm,0.34+0.5*release)+Vector3.yAxis*(0.45-0.34*release)
	local shoulderSide = if (wide.Position-focus):Dot(self.orientation.RightVector)<-1 then -1 else 1
	local lens = self.orientation:VectorToWorldSpace(Vector3.new(shoulderSide*(6.0-2.4*release),1.4, -2.7))
	local wall = workspace:Raycast(focus,lens,self.cameraFilter)
	if wall then lens = lens.Unit*math.max(0.1,wall.Distance-0.2) end
	local close = CFrame.lookAt(focus+lens,focus)
	local weight = ease(elapsed/0.32)*(1-ease((elapsed-1.46)/0.4))
	-- Orbit round the subject instead of cutting through the body on a reverse angle.
	local wideLens=wide.Position-focus
	local blendDir=wideLens:Lerp(lens,weight)
	if blendDir.Magnitude>0.05 and wideLens.Magnitude>0.1 then
		local position=focus+blendDir.Unit*(wideLens.Magnitude+(lens.Magnitude-wideLens.Magnitude)*weight)
		local occluder=workspace:Raycast(focus,position-focus,self.cameraFilter)
		if occluder then position=focus+blendDir.Unit*math.max(0.1,occluder.Distance-0.2) end
		close=CFrame.new(position)*wide.Rotation:Lerp(close.Rotation,weight)
	else close=wide:Lerp(close,weight) end
	camera.CFrame = close
	camera.Focus = (self.focus+offset):Lerp(CFrame.new(focus),weight)
end

function Lasso:step(now)
	if not self.grip and not self:bindHand() then
		return not self.endedAt and os.clock()-self.loadedAt < 8
	end
	if self.owner.Character ~= self.character or not self.grip.Parent or not self.root.Parent then return false end
	if self.reelStartedAt and not self.endedAt then self:finish(self.reelStartedAt) end
	local age = math.max(0, now-self.castAt)
	local finishAge = if self.endedAt then math.max(0,now-self.endedAt) else 0
	if self.endedAt and finishAge >= (if self.caught then catchDuration else 0.42) then return false end
	local throw = Catalog.flightProgress(age,self.reach)
	local swing = ease(age/windup)
	local phase = math.max(0,age-windup-self.castTime)*1.65
	local aim = CFrame.new(self.root.Position)*self.orientation
	local offset = Vector3.new(math.sin(phase)*4.8, 5.8+math.sin(phase)*0.95, -self.reach+(1-math.cos(phase))*1.25)
	local position = aim:PointToWorldSpace(offset)
	local scale = 0.50
	local palm = self.grip.WorldPosition
	if self.camera then self:updateCloseup(palm,finishAge) end
	local reel = if self.endedAt and self.caught then ease((finishAge-0.34)/(reelTime-0.34)) else 0
	if self.endedAt then
		local start = self.endPosition or position
		if self.caught then
			local resistance=math.sin(math.pi*ease(finishAge/0.43))*0.58
			position = start:Lerp(palm+Vector3.yAxis*0.38, reel) + Vector3.yAxis*math.sin(math.pi*reel)*1.7
				+ aim.LookVector*resistance
			scale = self.endScale+(0.095-self.endScale)*reel
		else
			position = start + aim:VectorToWorldSpace(Vector3.new(1,5,-7))*ease(finishAge/0.42)
			scale = self.endScale*(1-0.92*ease(finishAge/0.42))
		end
	end
	self.position = position
	if not self.scale or math.abs(self.scale-scale)>0.002 then
		self.moon:ScaleTo(self.baseScale * scale)
		self.scale = scale
	end
	self.moon:PivotTo(CFrame.new(position)*CFrame.Angles(0,age*0.55,0.12*math.sin(phase)))
	if throw>=1 and not self.moon.Parent and (not self.endedAt or self.caught) then
		self.moon.Parent = workspace
		if not self.endedAt then
			self:impact("hit",position)
			self.sparks:Emit(12)
		end
	end

	local launch = palm + aim:VectorToWorldSpace(Vector3.new(0.15,0.8,-0.24))
	if not self.castShown and age>=windup then
		self.castShown=true
		if age<windup+self.castTime and not self.endedAt then self:impact("cast",launch) end
	end
	local loop = launch:Lerp(position,throw) + Vector3.yAxis*(math.sin(math.pi*throw)*2.5)
	local radius = (0.22+0.8*swing)*(1-throw) + scale*5.05*throw
	self.rig.CFrame = CFrame.new(loop)*self.orientation*CFrame.Angles(-0.32, (1-throw)*swing*math.pi*2, 0.35)
	local visible = not self.endedAt or (self.caught and reel<0.96)
	local accent = if self.caught then gold else cold
	local intensity = if self.caught then 1-reel else 0
	self.outline.OutlineColor = Color3.fromHex("493D66"):Lerp(accent,intensity)
	self.outline.FillColor, self.outline.FillTransparency = accent,1-0.42*intensity
	for i,node in ipairs(self.nodes) do
		local angle = (i-1)*math.pi/2
		node.Position = Vector3.new(math.sin(angle)*radius, 0, math.cos(angle)*radius)
		node.Axis = Vector3.new(math.cos(angle), 0, -math.sin(angle))
		local arc = self.arcs[i]
		arc.Width0 = 0.105+intensity*0.13
		arc.CurveSize0, arc.CurveSize1 = radius*0.552285, radius*0.552285
		arc.Enabled = visible
	end
	local twoHands = self.leftGrip and self.leftGrip.Parent and age>=windup+self.castTime-0.03 and reel<0.77
	self.rope.Attachment0 = if twoHands then self.leftGrip else self.grip
	if self.between then
		self.between.Enabled = visible and twoHands==true
	end
	self.rope.CurveSize0 = (1-throw)*1.7 + 0.12
	self.rope.CurveSize1 = -self.rope.CurveSize0
	self.rope.Width0, self.rope.Enabled = 0.085+intensity*0.065, visible
	if throw>0 and throw<1 and visible and (position-palm).Magnitude>0.1 then
		self.comet.CFrame = CFrame.lookAlong(loop,(position-palm).Unit)*CFrame.Angles(0,0,math.pi/4)
		self.comet.Color,self.comet.Transparency = accent,0.04
	else
		self.comet.Transparency = 1
	end
	if now>=self.nextEcho and reel>0.08 and reel<0.91 then
		self.nextEcho=now+0.075
		Impact.echo(self.rig,position,scale*9.6,accent)
	end
	if self.caught and reel>=0.96 and not self.flared then
		self.flared = true
		self:impact("catch",position)
		self.sparks:Emit(22)
	end
	return true
end

function Lasso:destroy()
	if self.camera and self.camera==workspace.CurrentCamera and self.camera.CameraType==Enum.CameraType.Scriptable then
		local shift = if self.root.Parent then self.root.Position-self.cameraOrigin else Vector3.zero
		self.camera.CFrame,self.camera.Focus = self.wide+shift,self.focus+shift
		self.camera.CameraType = Enum.CameraType.Custom
	end
	if self.handAdded then self.handAdded:Disconnect() end
	if self.pose then self.pose:destroy() end
	if self.leftGrip then self.leftGrip:Destroy() end
	if self.gui then self.gui:Destroy() end
	if self.grip then self.grip:Destroy() end
	self.rig:Destroy()
	self.moon:Destroy()
end

return Lasso
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="115">
          <Properties>
            <string name="Name">LassoImpact</string>
            <string name="Source"><![CDATA[local Debris = game:GetService("Debris")
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")

local Impact = {}
local gold = Color3.fromHex("FFD260")
local white = Color3.fromHex("FFFFED")
local cyan = Color3.fromHex("65F4F7")
local violet = Color3.fromHex("AD7BFF")
local ink = Color3.fromHex("262143")

-- Length is in studs. Each beat has its own silhouette and timing.
local beats = {
	cast = {color=cyan, accent=violet, rays=9, length=3.4, time=0.37},
	hit = {color=gold, accent=cyan, rays=13, length=5.1, time=0.34},
	catch = {color=white, accent=gold, rays=18, length=5.6, time=0.49},
}

local function animate(item, time, properties)
	TweenService:Create(item,TweenInfo.new(time,Enum.EasingStyle.Quad,Enum.EasingDirection.Out),properties):Play()
end

local function effectPart(parent, name, frame)
	local p = Instance.new("Part")
	p.Name, p.CFrame, p.Size, p.Transparency = name, frame, Vector3.one*0.1, 1
	p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow = true,false,false,false,false
	p.Parent = parent
	return p
end

local function node(parent, pos, axis)
	local a = Instance.new("Attachment")
	a.Position, a.Axis, a.Parent = pos, axis, parent
	return a
end

local function stroke(parent, a, b, width, tip, color)
	local line = Instance.new("Beam")
	line.Attachment0, line.Attachment1 = a, b
	line.Width0, line.Width1 = width, tip
	line.Color, line.LightEmission = ColorSequence.new(color), 0.9
	line.FaceCamera, line.Segments, line.Parent = true, 8, parent
	return line
end

-- Two tapered semicircles read as brush strokes, even edge-on to the player.
local function shockRing(root, beat, radius, tilt)
	local frame = CFrame.Angles(tilt,0,0.3)
	local axis = frame.YVector
	local left = node(root, -frame.XVector*radius, axis)
	local right = node(root, frame.XVector*radius, -axis)
	local outer = radius*2.5
	animate(left,beat.time,{Position=-frame.XVector*outer})
	animate(right,beat.time,{Position=frame.XVector*outer})
	for side=1,2 do
		local a,b = left,right
		if side==2 then a,b=right,left end
		local line = stroke(root,a,b,0.22,0.025,if side==1 then beat.color else beat.accent)
		line.CurveSize0, line.CurveSize1 = radius*4/3, radius*4/3
		animate(line,beat.time,{CurveSize0=outer*4/3,CurveSize1=outer*4/3,Width0=0,Width1=0})
	end
end

function Impact.burst(parent, kind, position)
	local beat = beats[kind]
	local camera = workspace.CurrentCamera
	local frame = if camera then CFrame.new(position)*camera.CFrame.Rotation else CFrame.new(position)
	local root = effectPart(parent, "LassoImpact_"..kind, frame)
	Debris:AddItem(root,beat.time+0.08)
	shockRing(root,beat,beat.length*0.34,0.48)
	if kind=="catch" then shockRing(root,beat,1.15,-0.95) end
	for i=1,beat.rays do
		local angle = 2*math.pi*i/beat.rays + math.sin(i*2.4)*0.12
		local direction = Vector3.new(math.cos(angle),math.sin(angle),0)
		local length = beat.length*(0.72 + 0.28*math.cos(i*1.4))
		local base = node(root,direction*length*0.22,direction)
		local tip = node(root,direction*length*0.65,direction)
		local color = if i%3==0 then beat.accent else beat.color
		local line = stroke(root,base,tip,if i%3==0 then 0.28 else 0.15,0.015,color)
		animate(base,beat.time,{Position=direction*length*0.82})
		animate(tip,beat.time,{Position=direction*length*1.3})
		animate(line,beat.time,{Width0=0,Width1=0})
	end
end

function Impact.echo(parent, position, diameter, color)
	local ghost = effectPart(parent,"LassoAfterimage",CFrame.new(position))
	ghost.Shape, ghost.Material, ghost.Color = Enum.PartType.Ball,Enum.Material.Neon,color
	ghost.Size, ghost.Transparency = Vector3.one*diameter,0.76
	animate(ghost,0.18,{Size=Vector3.one*diameter*0.78,Transparency=1})
	Debris:AddItem(ghost,0.22)
end

-- Keep the centre of the screen and the timing bar clear throughout the impact.
function Impact.screen(gui, kind)
	if not gui or GuiService.ReducedMotionEnabled then return end
	local camera = workspace.CurrentCamera
	if not camera then return end
	local size,beat = camera.ViewportSize,beats[kind]
	local group = Instance.new("Frame")
	group.Name,group.BackgroundTransparency,group.Size = "ImpactLines",1,UDim2.fromScale(1,1)
	group.ClipsDescendants,group.Parent = true,gui
	Debris:AddItem(group,beat.time+0.04)
	for i=1,20 do
		local angle = i*math.pi/10+0.08
		local x,y = math.cos(angle), math.sin(angle)
		local boundary = math.min(size.X/(2*math.abs(x)),size.Y/(2*math.abs(y)))
		local length = math.min(boundary*0.4,120)*(0.63+0.37*math.abs(math.sin(i*2)))
		local line = Instance.new("Frame")
		line.AnchorPoint, line.Rotation = Vector2.new(0.5,0.5), math.deg(angle)
		line.Position = UDim2.fromOffset(size.X/2+x*(boundary-length*0.38),size.Y/2+y*(boundary-length*0.38))
		line.Size, line.BorderSizePixel = UDim2.fromOffset(length,if i%3==0 then 5 else 2),0
		line.BackgroundColor3 = if i%4==0 then ink elseif i%3==0 then beat.accent else beat.color
		local gradient = Instance.new("UIGradient")
		gradient.Transparency,gradient.Parent = NumberSequence.new(1,0.12),line
		line.Parent = group
		animate(line,beat.time,{Position=UDim2.fromOffset(size.X/2+x*boundary,size.Y/2+y*boundary),BackgroundTransparency=1})
	end
end

return Impact
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="116">
          <Properties>
            <string name="Name">MoonScene</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Catalog = require(game.ReplicatedStorage:WaitForChild("MoonCatalog"))
local PlanetModel = require(game.ReplicatedStorage:WaitForChild("PlanetModel"))
local Lasso = require(script.Parent:WaitForChild("Lasso"))
local MoonScene = {}
MoonScene.__index = MoonScene

local center = Vector3.new(0, 16, 0)
local radius = 4.8

local function makePlanet(planet, name)
	local model = PlanetModel.new(planet.appearance, radius)
	model.Name = name
	local surface = model.PrimaryPart
	local glow = Instance.new("PointLight")
	glow.Color, glow.Brightness, glow.Range, glow.Parent = surface.Color, 2, 32, surface
	return model
end

function MoonScene.new()
	local idle = makePlanet(Catalog.Planets[1], "PersonalPlanet")
	local camera = workspace.CurrentCamera
	local direction = if camera then camera.CFrame.Position - center else Vector3.zAxis
	local yaw = math.atan2(direction.X, direction.Z)
	local self = setmetatable({active = {}, idle = idle, elapsed = 0, time = 0}, MoonScene)
	RunService:BindToRenderStep("LunarObservatoryView", Enum.RenderPriority.Camera.Value+1, function(dt)
		self.elapsed += dt
		if not self.active[Players.LocalPlayer] and self.elapsed < 1/30 then return end
		dt, self.elapsed = self.elapsed, 0
		self.time += dt
		local now = workspace:GetServerTimeNow()
		for owner, lasso in pairs(self.active) do
			if not lasso:step(now) then self:remove(owner) end
		end
		if next(self.active) == nil then
			idle:PivotTo(CFrame.new(center + Vector3.yAxis*math.sin(self.time*1.3)*0.21)
				* CFrame.Angles(0, yaw+self.time*0.065, 0))
			if not idle.Parent then idle.Parent = workspace end
		end
	end)
	Players.PlayerRemoving:Connect(function(owner) self:remove(owner) end)
	return self
end

function MoonScene:remove(owner)
	local lasso = self.active[owner]
	if lasso then
		lasso:destroy()
		self.active[owner] = nil
	end
end

function MoonScene:progress(owner, packet)
	if not owner then return end
	local lasso = self.active[owner]
	if lasso and lasso.id == packet.id then
		lasso.reelStartedAt = packet.reelStartedAt or lasso.reelStartedAt
		return
	end
	self:remove(owner)
	self.idle.Parent = nil
	local planet = makePlanet(Catalog.Planets[packet.index], "LassoPlanet")
	planet:SetAttribute("OwnerId", owner.UserId)
	self.active[owner] = Lasso.new(owner, packet, planet)
end

function MoonScene:finish(owner, id, reelStartedAt)
	local lasso = self.active[owner]
	if lasso and lasso.id == id then lasso:finish(reelStartedAt) end
end

return MoonScene
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="117">
          <Properties>
            <string name="Name">PullPose</string>
            <string name="Source"><![CDATA[local RunService = game:GetService("RunService")

local PullPose = {}
PullPose.__index = PullPose

local function smooth(x)
	x = math.clamp(x,0,1)
	return x*x*(3-2*x)
end

-- The hands reach first. The hips take the load, then the elbows travel past the ribs.
-- Columns: seconds, draw towards hip, knee compression, shoulder turn, forward-hand travel.
local haul = {
	{0,    0.02, 0.42,  0.06, 0.00},
	{0.16,-0.82, 0.80, -0.30, 0.25},
	{0.32,-0.73, 1.00, -0.22, 0.28},
	{0.49, 0.72, 0.73,  0.76, 0.03},
	{0.61, 1.00, 0.52,  1.00, 0.00},
	{0.76, 0.89, 0.60,  0.83, 0.04},
	{1.04, 0.12, 0.42,  0.12, 0.08},
}

local function sample(keys,t)
	for i=2,#keys do
		local a,b = keys[i-1],keys[i]
		if t<=b[1] then
			local w=smooth((t-a[1])/(b[1]-a[1]))
			return a[2]+(b[2]-a[2])*w, a[3]+(b[3]-a[3])*w,
				a[4]+(b[4]-a[4])*w, a[5]+(b[5]-a[5])*w
		end
	end
	local last=keys[#keys]
	return last[2],last[3],last[4],last[5]
end

local function unit(v,fallback)
	return if v.Magnitude>0.0001 then v.Unit else fallback
end

-- Swing a bone from its own bind direction. Avatar packages use different joint axes.
local function align(rotation, localBone, direction)
	local from=rotation:VectorToWorldSpace(unit(localBone,-Vector3.yAxis))
	local to=unit(direction,from)
	local axis=from:Cross(to)
	if axis.Magnitude>0.0001 then
		return CFrame.fromAxisAngle(axis.Unit,math.atan2(axis.Magnitude,from:Dot(to)))*rotation
	end
	if from:Dot(to)<0 then
		return CFrame.fromAxisAngle(unit(from:Cross(Vector3.xAxis),Vector3.zAxis),math.pi)*rotation
	end
	return rotation
end

local function isJoint(j)
	return j:IsA("Motor6D") or j:IsA("AnimationConstraint")
end

function PullPose:restore()
	for joint,original in pairs(self.originals) do
		if joint.Parent then joint.Transform=original end
	end
	table.clear(self.originals)
end

function PullPose:bind()
	local joints={}
	for _,joint in self.char:GetDescendants() do
		if isJoint(joint) and joint.Part0 and joint.Part1 and joint.Part0.Parent==self.char and joint.Part1.Parent==self.char then
			joints[joint.Part1.Name]=joint
		end
	end
	self.joints=joints
	self.torso=joints.LowerTorso or joints.Torso
	self.r15=joints.LowerTorso~=nil
	self.rest={[self.root]=CFrame.identity}
	local function restFrame(j)
		local cached=self.rest[j.Part1]
		if cached then return cached end
		local parent=self.rest[j.Part0]
		if not parent then
			local ancestor=joints[j.Part0.Name]
			if not ancestor then return self.root.CFrame:ToObjectSpace(j.Part1.CFrame) end
			parent=restFrame(ancestor)
		end
		local cf=parent*j.C0*j.C1:Inverse()
		self.rest[j.Part1]=cf
		return cf
	end
	for _,j in pairs(joints) do restFrame(j) end
end

-- All desired frames are in root space. Compose through the evaluated parent so IK
-- accounts for the lean already applied to the pelvis and rib cage in this frame.
function PullPose:write(j, desired, weight)
	local parent=self.frames[j.Part0] or self.rest[j.Part0]
	if not parent then return end
	local origin=parent*j.C0
	local base=j.Transform
	self.originals[j]=base
	local result=base:Lerp(origin:ToObjectSpace(desired*j.C1),weight)
	j.Transform=result
	self.frames[j.Part1]=origin*result*j.C1:Inverse()
end

function PullPose:pivot(j,rotation,offset,weight)
	if not j then return end
	local parent=self.frames[j.Part0] or self.rest[j.Part0]
	if not parent then return end
	local socket=parent*j.C0
	local neutral=socket*j.C1:Inverse()
	local rotated=parent.Rotation*rotation*parent.Rotation:Inverse()*neutral.Rotation
	local cf=CFrame.new(socket.Position+offset)*rotated*CFrame.new(-j.C1.Position)
	self:write(j,cf,weight)
end

function PullPose:chain(upper,lower,tip,contact,target,tipRotation,pole,weight)
	if not upper then return end
	local parent=self.frames[upper.Part0] or self.rest[upper.Part0]
	if not parent then return end
	local socket=parent*upper.C0
	local start=socket.Position
	local restRotation=(socket*upper.C1:Inverse()).Rotation
	if not lower or not tip then
		-- An R6 limb is a single rigid segment.
		local rot=align(restRotation,contact-upper.C1.Position,target-start)
		self:write(upper,CFrame.new(start)*rot*CFrame.new(-upper.C1.Position),weight)
		return
	end
	local upperBone=lower.C0.Position-upper.C1.Position
	local lowerBone=tip.C0.Position-lower.C1.Position
	local a,b=upperBone.Magnitude,lowerBone.Magnitude
	if math.min(a,b)<0.01 then return end
	local wrist=target+tipRotation:VectorToWorldSpace(tip.C1.Position-contact)
	local axis=unit(wrist-start,-Vector3.zAxis)
	local length=math.clamp((wrist-start).Magnitude,math.abs(a-b)+0.001,a+b-0.001)
	local along=(a*a-b*b+length*length)/(2*length)
	local outward=pole-start
	local bend=unit(outward-axis*outward:Dot(axis),unit(axis:Cross(Vector3.xAxis),Vector3.zAxis))
	local elbow=start+axis*along+bend*math.sqrt(math.max(0,a*a-along*along))
	local rot=align(restRotation,upperBone,elbow-start)
	self:write(upper,CFrame.new(start)*rot*CFrame.new(-upper.C1.Position),weight)
	local hinge=self.frames[upper.Part1]*lower.C0
	local forearm=align((hinge*lower.C1:Inverse()).Rotation,lowerBone,start+axis*length-hinge.Position)
	self:write(lower,CFrame.new(hinge.Position)*forearm*CFrame.new(-lower.C1.Position),weight)
	local wristFrame=self.frames[lower.Part1]*tip.C0
	self:write(tip,CFrame.new(wristFrame.Position)*tipRotation*CFrame.new(-tip.C1.Position),weight)
end

function PullPose:legs(facing,weight)
	local j=self.joints
	for _,side in {"Left","Right"} do
		local sign=if side=="Left" then -1 else 1
		local hip=j[side.."UpperLeg"] or j[side.." Leg"]
		local knee,ankle=j[side.."LowerLeg"],j[side.."Foot"]
		if not hip then continue end
		local foot=if ankle then ankle.Part1 else hip.Part1
		local sole=Vector3.new(0,-foot.Size.Y*0.5,0)
		local standing=self.rest[foot]:PointToWorldSpace(sole)
		local target=facing:PointToWorldSpace(standing+Vector3.new(sign*0.22,0,sign*0.42)*self.size)
		local kneePole=facing:PointToWorldSpace(Vector3.new(sign*0.85,-1.4,-2)*self.size)
		self:chain(hip,knee,ankle,sole,target,facing*CFrame.Angles(0,-sign*0.13,0),kneePole,weight)
	end
end

-- Grip attachments sit near the fingers. Leave room for the palm and sleeve as
-- the chest rotates over the belt, particularly on broad layered-clothing avatars.
function PullPose:clearPalm(target,handRotation,grip)
	local palm=target-handRotation:VectorToWorldSpace(grip.Position)
	for _,name in if self.r15 then {"UpperTorso","LowerTorso"} else {"Torso"} do
		local joint=self.joints[name]
		local frame=joint and self.frames[joint.Part1]
		if not frame then continue end
		local v=frame:PointToObjectSpace(palm)
		local half=joint.Part1.Size*0.5
		local margin=self.size*0.27
		if math.abs(v.X)<half.X+margin and math.abs(v.Y)<half.Y+margin then
			local push=frame.LookVector*math.max(0,v.Z+half.Z+margin)
			target+=push
			palm+=push
		end
	end
	return target
end

function PullPose:step(dt)
	if self.dirty then self.dirty=false; self:bind() end
	local l,root=self.lasso,self.root
	if not self.torso or not root.Parent or l.owner.Character~=self.char then return end
	local now=workspace:GetServerTimeNow()
	local age=math.max(0,now-l.castAt)
	local ending=if l.endedAt then now-l.endedAt else 0
	local release=if l.caught then smooth((ending-1.48)/0.38) else smooth(ending/0.38)
	local weight=smooth(age/0.15)*(1-release)
	if weight<=0 then return end
	local look=root.CFrame:VectorToObjectSpace(l.orientation.LookVector)
	local yaw=math.atan2(-look.X,-look.Z)
	self.yaw+=math.atan2(math.sin(yaw-self.yaw),math.cos(yaw-self.yaw))*(1-math.exp(-dt*12))
	local facing=CFrame.Angles(0,self.yaw,0)
	local velocity=root.AssemblyLinearVelocity
	local planted=self.humanoid.FloorMaterial~=Enum.Material.Air and Vector3.new(velocity.X,0,velocity.Z).Magnitude<3.2
	self.stance+=((if planted then 1 else 0)-self.stance)*(1-math.exp(-dt*12))

	local cycle=age*4.15
	local draw=0.12+0.22*math.sin(cycle)
	local compression=0.44+0.08*math.cos(cycle)
	local turn=0.12+0.15*math.sin(cycle-0.3)
	local slide=0.14+0.13*math.cos(cycle)
	if l.caught then
		draw,compression,turn,slide=sample(haul,ending*0.93)
		draw*=1.17
	end
	local blend=1-math.exp(-dt*29)
	self.draw+=(draw-self.draw)*blend
	self.compression+=(compression-self.compression)*blend
	self.turn+=(turn-self.turn)*blend
	self.slide+=(slide-self.slide)*blend
	draw,compression,turn,slide=self.draw,self.compression,self.turn,self.slide
	local latched=smooth((age-0.35)/(l.castTime-0.07))
	local received=if l.caught then smooth((ending-0.76)/0.42) else 0
	local body=latched*(1-received*0.68)
	local tremor=(math.sin(age*43)+0.38*math.sin(age*67))*0.014*body*(0.45+compression)
	local scale=self.size
	local hips=facing:VectorToWorldSpace(Vector3.new(0.11*turn,-compression*(if self.r15 then 0.53 else 0.19),0.23+0.36*draw)*scale)*self.stance*body
	local lean=math.rad(12+23*draw)*body
	table.clear(self.frames)
	self.frames[root]=CFrame.identity
	local pelvis=facing*CFrame.Angles(lean*(if self.r15 then 0.58 else 1),-0.26*turn*body,0.07*turn*body)
	self:pivot(self.torso,pelvis,hips,weight)
	self:pivot(self.joints.UpperTorso,CFrame.Angles(lean*0.54+tremor,-0.28*turn*body,0.05*turn*body),Vector3.zero,weight)
	self:pivot(self.joints.Head,CFrame.Angles(0.09-lean*0.76,0.34*turn*body,0.04*turn),Vector3.zero,weight*0.86)
	if self.stance>0.01 then self:legs(facing,weight*self.stance*latched) end

	local shoulder=self.joints.RightUpperArm or self.joints["Right Arm"]
	if not shoulder then return end
	local chest=self.frames[shoulder.Part0]
	if not chest then return end
	local height=(chest*shoulder.C0).Position.Y
	local other=self.joints.LeftUpperArm or self.joints["Left Arm"]
	local shoulderLine=if other then (shoulder.C0.Position+other.C0.Position)*0.5 else Vector3.new(0,shoulder.C0.Y,0)
	local shoulders=chest:PointToWorldSpace(shoulderLine)
	local rear=shoulders+chest:VectorToWorldSpace(Vector3.new(0.12+0.57*draw,-0.44-0.43*draw,-1.19+0.25*draw)*scale)
	local aim=if l.position then root.CFrame:PointToObjectSpace(l.position) else facing:PointToWorldSpace(Vector3.new(0,5,-10))
	local rope=unit(aim-rear,facing.LookVector)
	local front=rear+rope*(0.44+slide*0.85)*scale
	-- Bring the extended hand across the sternum and the rear hand to the belt.
	local gather=shoulders+facing:VectorToWorldSpace(Vector3.new(0.31,-0.32,-0.88)*scale)
	rear=rear:Lerp(gather,received)
	front=front:Lerp(gather+facing:VectorToWorldSpace(Vector3.new(-0.42,-0.08,0.03)*scale),received)
	for _,side in {"Right","Left"} do
		local right=side=="Right"
		local sign=if right then 1 else -1
		local grip=if right then l.grip else l.leftGrip
		if not grip then continue end
		local arm=self.joints[side.."UpperArm"] or self.joints[side.." Arm"]
		local elbow,wrist=self.joints[side.."LowerArm"],self.joints[side.."Hand"]
		local wind=smooth(age/0.25)
		local cast=if right then Vector3.new(0.90+0.32*wind,height/scale+0.91*wind,-0.48+0.85*wind)
			else Vector3.new(-0.69,height/scale-0.69,-0.41)
		local target=facing:PointToWorldSpace(cast*scale):Lerp(if right then rear else front,latched)
		local pole=shoulders+facing:VectorToWorldSpace(Vector3.new(sign*(1.40+0.24*draw),-0.85,0.68+0.76*draw)*scale)
		local handRotation=facing*CFrame.Angles(1.22+0.19*draw,-sign*0.32,-sign*(0.47+0.35*received))
		local clear=self:clearPalm(target,handRotation,grip)
		self:chain(arm,elbow,wrist,grip.Position,target:Lerp(clear,latched),handRotation,pole,weight)
	end
end

function PullPose.new(lasso,humanoid)
	local self=setmetatable({lasso=lasso,char=lasso.character,root=lasso.root,humanoid=humanoid,
		size=lasso.root.Size.Y/2,stance=0,yaw=0,draw=0,compression=0.4,turn=0,slide=0,
		originals={},frames={},dirty=true},PullPose)
	self.added=self.char.DescendantAdded:Connect(function(item) if isJoint(item) then self.dirty=true end end)
	self.removing=self.char.DescendantRemoving:Connect(function(item) if isJoint(item) then self.dirty=true end end)
	-- Let Animate produce a clean base first, then pose both legacy and upgraded joints.
	self.before=RunService.PreAnimation:Connect(function() self:restore() end)
	self.after=RunService.PreSimulation:Connect(function(dt) self:step(dt) end)
	return self
end

function PullPose:destroy()
	self.before:Disconnect()
	self.after:Disconnect()
	self.added:Disconnect()
	self.removing:Disconnect()
	self:restore()
end

return PullPose
]]></string>
