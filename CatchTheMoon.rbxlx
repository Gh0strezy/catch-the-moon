    <Item class="ModuleScript" referent="4">
      <Properties>
        <string name="Name">MoonCatalog</string>
        <string name="Source"><![CDATA[local Catalog = {}

Catalog.Taps = 18
Catalog.RevealTime = 3
Catalog.MaxLevel = 12
Catalog.Moons = {
	{ id = "chalk", name = "Меловая", rarity = "Обычная", weight = 58, dust = 8, color = "D7DDE5", dark = "838BA8" },
	{ id = "tidal", name = "Приливная", rarity = "Необычная", weight = 27, dust = 16, color = "79E4D6", dark = "368A9B" },
	{ id = "orchid", name = "Орхидея", rarity = "Редкая", weight = 11, dust = 36, color = "C1A3FF", dark = "7955BA" },
	{ id = "ember", name = "Янтарная", rarity = "Эпическая", weight = 3.5, dust = 80, color = "FFC377", dark = "CD764C" },
	{ id = "corona", name = "Корона", rarity = "Легендарная", weight = 0.5, dust = 200, color = "FFE7A1", dark = "D9924E" },
}

function Catalog.luck(level)
	return 1 + level * 0.25
end

function Catalog.price(level)
	return 24 + 12 * level + 4 * level * level
end

-- The same cumulative boundaries drive the server roll and the percentages in the atlas.
function Catalog.chances(level)
	local chances = {}
	local weight, previous = 0, 0
	for index, moon in ipairs(Catalog.Moons) do
		weight += moon.weight
		local cumulative = (weight / 100) ^ Catalog.luck(level)
		chances[index] = cumulative - previous
		previous = cumulative
	end
	return chances
end

function Catalog.roll(level, sample)
	local total = 0
	for index, probability in ipairs(Catalog.chances(level)) do
		total += probability
		if sample < total then return index end
	end
	return #Catalog.Moons
end

function Catalog.newProfile()
	return { dust = 0, level = 0, counts = {} }
end

function Catalog.upgrade(profile)
	if profile.level >= Catalog.MaxLevel then return false end
	local price = Catalog.price(profile.level)
	if profile.dust < price then return false end
	profile.dust -= price
	profile.level += 1
	return true
end

function Catalog.award(profile, index)
	local moon = Catalog.Moons[index]
	profile.counts[moon.id] = (profile.counts[moon.id] or 0) + 1
	profile.dust += moon.dust
end

return Catalog
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="5">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="6">
      <Properties>
        <string name="Name">LunarStation</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Catalog = require(ReplicatedStorage:WaitForChild("MoonCatalog"))
local ProfileStore = require(script.ProfileStore)
local Round = require(script.Round)

local event = Instance.new("RemoteEvent")
event.Name = "MoonStationEvent"
local round = Round.new(Catalog.Taps)
local random = Random.new()
local profiles, loading, lastSync = {}, {}, {}
local closing, pending = false, 0
local lastHit = 0

local function sendProfile(player, profile)
	event:FireClient(player, "profile", profile.data, profile.practice == true)
end

local function load(player)
	if closing or loading[player] or profiles[player] then return end
	loading[player] = true
	pending += 1
	local profile = ProfileStore.open(player)
	if closing or player.Parent ~= Players then
		if profile then profile:save(true) end
	elseif profile then
		profiles[player] = profile
		sendProfile(player, profile)
		event:FireClient(player, "round", round:packet())
	else
		player:Kick("Коллекция занята или временно недоступна. Зайди через минуту.")
	end
	loading[player] = nil
	pending -= 1
end

local function close(player)
	local profile = profiles[player]
	profiles[player] = nil
	lastSync[player] = nil
	round:remove(player)
	if profile then
		pending += 1
		if not profile:save(true) then warn("Could not finish saving lunar collection", player.UserId) end
		pending -= 1
	end
end

event.OnServerEvent:Connect(function(player, action, roundId)
	local profile = profiles[player]
	if closing or not profile or profile.closed then return end
	local now = os.clock()
	if action == "sync" then
		if lastSync[player] and now - lastSync[player] < 1 then return end
		lastSync[player] = now
		sendProfile(player, profile)
		event:FireClient(player, "round", round:packet())
	elseif action == "upgrade" then
		if Catalog.upgrade(profile.data) then sendProfile(player, profile) end
	elseif action == "tap" and round:tap(player, roundId, now) then
		lastHit = now
		event:FireAllClients("round", round:packet())
		if not round.paused then return end
		for member in pairs(round.contributors) do
			local session = profiles[member]
			if session and not session.closed then
				local index = Catalog.roll(session.data.level, random:NextNumber())
				Catalog.award(session.data, index)
				sendProfile(member, session)
				event:FireClient(member, "catch", index)
			end
		end
		task.delay(Catalog.RevealTime, function()
			round:restart()
			event:FireAllClients("round", round:packet())
		end)
	end
end)

event.Parent = ReplicatedStorage
Players.PlayerAdded:Connect(load)
Players.PlayerRemoving:Connect(close)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(load, player) end

task.spawn(function()
	while not closing do
		task.wait(5)
		if round.hits > 0 and not round.paused and os.clock() - lastHit > 45 then
			round:restart()
			event:FireAllClients("round", round:packet())
		end
	end
end)

task.spawn(function()
	while not closing do
		task.wait(50)
		for player, profile in pairs(profiles) do
			task.spawn(function()
				if not profile:save(false) then
					warn("Could not renew lunar collection", player.UserId)
					if profile.closed and player.Parent == Players then player:Kick("Коллекция открыта в другой сессии.") end
				end
			end)
		end
	end
end)

game:BindToClose(function()
	closing = true
	for player in pairs(table.clone(profiles)) do task.spawn(close, player) end
	while pending > 0 do task.wait(0.1) end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Catalog = require(game.ReplicatedStorage.MoonCatalog)

local ProfileStore = {}
ProfileStore.__index = ProfileStore
local LEASE_SECONDS = 180

function ProfileStore.open(player)
	local self = setmetatable({
		data = Catalog.newProfile(), key = "player_" .. player.UserId,
		token = HttpService:GenerateGUID(false), saving = false, closed = false,
	}, ProfileStore)
	-- Studio playtests use isolated session data, even if production API access is enabled.
	if RunService:IsStudio() then
		self.practice = true
		return self
	end
	for attempt = 1, 3 do
		local ok, record = pcall(function()
			self.store = DataStoreService:GetDataStore("CatchTheMoon_v1")
			return self.store:UpdateAsync(self.key, function(old)
				if old and old.version ~= 1 then return nil end
				if old and old.owner and old.owner ~= self.token and old.expires > os.time() then return nil end
				return { version = 1, data = old and old.data or Catalog.newProfile(),
					owner = self.token, expires = os.time() + LEASE_SECONDS }
			end)
		end)
		if ok and record and record.owner == self.token then
			self.data = record.data
			return self
		end
		if attempt < 3 then task.wait(2 * attempt) end
	end
	return nil
end

function ProfileStore:save(release)
	if self.saving and not release then return true end
	while self.saving do task.wait() end
	if self.practice or self.closed then return true end
	self.saving = true
	local snapshot = { dust = self.data.dust, level = self.data.level, counts = table.clone(self.data.counts) }
	local attempts = if release then 3 else 1
	local success = false
	for attempt = 1, attempts do
		local ok, stored = pcall(function()
			return self.store:UpdateAsync(self.key, function(old)
				if not old or old.owner ~= self.token then return nil end
				return { version = 1, data = snapshot, owner = if release then nil else self.token,
					expires = if release then 0 else os.time() + LEASE_SECONDS }
			end)
		end)
		if ok then
			success = stored ~= nil
			self.closed = release or not success
			break
		end
		if attempt < attempts then task.wait(attempt) end
	end
	self.saving = false
	return success
end

return ProfileStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Round</string>
          <string name="Source"><![CDATA[local Round = {}
Round.__index = Round

function Round.new(goal)
	return setmetatable({ goal = goal, id = 1, hits = 0, paused = false, contributors = {} }, Round)
end

function Round:restart()
	self.id += 1
	self.hits = 0
	self.paused = false
	table.clear(self.contributors)
end

function Round:remove(player)
	self.contributors[player] = nil
end

function Round:tap(player, roundId, now)
	if self.paused or self.id ~= roundId then return false end
	local last = self.contributors[player]
	if last and now - last < 0.09 then return false end
	self.contributors[player] = now
	self.hits += 1
	self.paused = self.hits >= self.goal
	return true
end

function Round:packet()
	local crew = 0
	for _ in pairs(self.contributors) do crew += 1 end
	return { id = self.id, hits = self.hits, goal = self.goal, paused = self.paused, crew = crew }
end

return Round
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="9">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="10">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="11">
        <Properties>
          <string name="Name">LunarStation</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Input = game:GetService("UserInputService")
local Actions = game:GetService("ContextActionService")
local storage = game:GetService("ReplicatedStorage")
local Catalog = require(storage:WaitForChild("MoonCatalog"))
local Interface = require(script:WaitForChild("Interface"))
local MoonScene = require(script:WaitForChild("MoonScene"))

local event = storage:WaitForChild("MoonStationEvent")
local ui = Interface.new(Players.LocalPlayer:WaitForChild("PlayerGui"))
local moon = MoonScene.new()
local round, ready = nil, false
local lastTap = -math.huge

local function tap()
	if not ready or not round or round.paused or ui.overlay.Visible then return end
	local now = os.clock()
	if now-lastTap < 0.095 then return end
	lastTap = now
	moon.pulse = 1
	event:FireServer("tap", round.id)
end
ui.tap.Activated:Connect(tap)
ui.upgrade.Activated:Connect(function()
	if ui.canUpgrade then event:FireServer("upgrade") end
end)
Input.InputBegan:Connect(function(input, handled)
	if not handled and input.UserInputType == Enum.UserInputType.MouseButton1 and moon:hitTest(input.Position) then tap() end
end)
Input.TouchTapInWorld:Connect(function(point, handled)
	if not handled and moon:hitTest(point) then tap() end
end)
Actions:BindActionAtPriority("CatchMoon",function(_,state)
	if Input:GetFocusedTextBox() or ui.overlay.Visible then return Enum.ContextActionResult.Pass end
	if state == Enum.UserInputState.Begin then tap() end
	return Enum.ContextActionResult.Sink
end,false,Enum.ContextActionPriority.High.Value,Enum.KeyCode.Space,Enum.KeyCode.ButtonR2)

event.OnClientEvent:Connect(function(action, data, practice)
	if action == "profile" then
		ui:profile(data, practice)
		ready = true
	elseif action == "round" then
		if round and round.id ~= data.id then moon:show() end
		round = data
		moon:progress(data)
		ui:progress(data)
	elseif action == "catch" then
		local caught = Catalog.Moons[data]
		moon:show(caught, data)
		ui:reveal(caught)
	end
end)
event:FireServer("sync")
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">Interface</string>
            <string name="Source"><![CDATA[local Catalog = require(game.ReplicatedStorage:WaitForChild("MoonCatalog"))
local Interface = {}
Interface.__index = Interface

local ink, panel, line = Color3.fromHex("11182B"), Color3.fromHex("202B43"), Color3.fromHex("53637F")
local paper, muted, gold = Color3.fromHex("F2EFE6"), Color3.fromHex("B5C4DD"), Color3.fromHex("FFD391")
local function box(class, parent, name, size, pos, color)
	local o = Instance.new(class)
	o.Name, o.Size, o.Position = name, size, pos
	o.BorderSizePixel = 0
	o.BackgroundColor3 = color or ink
	o.BackgroundTransparency = if color then 0 else 1
	o.Parent = parent
	return o
end
local function shape(o, radius, border)
	local corner = Instance.new("UICorner")
	corner.CornerRadius, corner.Parent = UDim.new(0,radius), o
	if border then
		local s = Instance.new("UIStroke")
		s.Color, s.Transparency, s.ApplyStrokeMode, s.Parent = border, 0.2, Enum.ApplyStrokeMode.Border, o
	end
end
local function label(parent, name, value, size, pos, textSize, color, font)
	local o = box("TextLabel",parent,name,size,pos)
	o.Text, o.TextSize, o.TextColor3 = value,textSize,color or paper
	o.Font = font or Enum.Font.GothamMedium
	o.TextXAlignment = Enum.TextXAlignment.Left
	return o
end
local function button(parent,name,value,size,pos,color)
	local o = box("TextButton",parent,name,size,pos,color or panel)
	o.Text, o.TextSize, o.Font = value,16,Enum.Font.GothamBold
	o.TextColor3 = if color == gold then ink else paper
	o.AutoButtonColor = true
	shape(o,10,if color == gold then nil else line)
	return o
end
local function fit(o, maxWidth, maxHeight)
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize, limit.Parent = Vector2.new(maxWidth,maxHeight), o
end

function Interface.new(parent)
	local self = setmetatable({rows = {}}, Interface)
	local gui = Instance.new("ScreenGui")
	gui.Name, gui.ResetOnSpawn, gui.DisplayOrder = "MoonStation",false,3
	gui.ZIndexBehavior, gui.Parent = Enum.ZIndexBehavior.Sibling,parent
	self.gui = gui
	local full = UDim2.fromScale(1,1)
	local header = box("Frame",gui,"Status",UDim2.new(1,-28,0,56),UDim2.fromOffset(14,6))
	self.title = label(header,"Title","Поймай Луну",UDim2.new(1,-125,0,29),UDim2.fromOffset(0,0),25,paper,Enum.Font.GothamBold)
	self.stats = label(header,"Resources","Подключение…",UDim2.new(1,-104,0,22),UDim2.fromOffset(1,30),14,gold)
	self.atlas = button(header,"Atlas","Атлас   0/5",UDim2.fromOffset(106,40),UDim2.new(1,-106,0,0))

	local dock = box("Frame",gui,"Capture",UDim2.new(1,-24,0,102),UDim2.new(0.5,0,1,-10),ink)
	dock.AnchorPoint = Vector2.new(0.5,1)
	dock.BackgroundTransparency = 0.05
	shape(dock,14,line)
	fit(dock,510,110)
	self.status = label(dock,"Status","Поиск орбиты…",UDim2.new(1,-110,0,22),UDim2.fromOffset(14,6),15,paper)
	self.meter = label(dock,"Count","",UDim2.fromOffset(80,22),UDim2.new(1,-94,0,6),15,muted)
	self.meter.TextXAlignment = Enum.TextXAlignment.Right
	local track = box("Frame",dock,"Track",UDim2.new(1,-28,0,5),UDim2.fromOffset(14,34),panel)
	shape(track,3)
	self.fill = box("Frame",track,"Fill",UDim2.fromScale(0,1),UDim2.fromOffset(0,0),gold)
	shape(self.fill,3)
	self.tap = button(dock,"Tap","Ловить Луну",UDim2.new(0.62,-17,0,43),UDim2.fromOffset(12,48),gold)
	self.luck = button(dock,"Luck","Удача  +",UDim2.new(0.38,-13,0,43),UDim2.new(0.62,5,0,48))

	local overlay = box("TextButton",gui,"AtlasBackdrop",full,UDim2.fromOffset(0,0),ink)
	overlay.Text, overlay.AutoButtonColor, overlay.Modal = "",false,true
	overlay.BackgroundTransparency, overlay.Visible, overlay.ZIndex = 0.18,false,10
	self.overlay = overlay
	local sheet = box("Frame",overlay,"AtlasPanel",UDim2.new(1,-24,1,-18),UDim2.fromScale(0.5,0.5),ink)
	sheet.AnchorPoint, sheet.Active = Vector2.new(0.5,0.5),true
	fit(sheet,500,500)
	shape(sheet,16,line)
	label(sheet,"Title","Атлас лун",UDim2.new(1,-82,0,34),UDim2.fromOffset(16,10),25,paper,Enum.Font.GothamBold)
	local close = button(sheet,"Close","×",UDim2.fromOffset(36,36),UDim2.new(1,-50,0,10))
	close.Activated:Connect(function() overlay.Visible = false end)
	local scroll = box("ScrollingFrame",sheet,"Entries",UDim2.new(1,-24,1,-121),UDim2.fromOffset(12,53))
	scroll.ScrollBarThickness, scroll.ScrollBarImageColor3 = 4,line
	scroll.CanvasSize = UDim2.fromOffset(0,#Catalog.Moons*58+36)
	for i, moon in ipairs(Catalog.Moons) do
		local row = box("Frame",scroll,moon.id,UDim2.new(1,-8,0,51),UDim2.fromOffset(0,(i-1)*58),panel)
		shape(row,10)
		local badge = box("Frame",row,"Moon",UDim2.fromOffset(30,30),UDim2.fromOffset(10,10),Color3.fromHex(moon.color))
		shape(badge,15)
		for j,dot in ipairs({{7,6,8},{17,15,6},{6,19,4}}) do
			local crater = box("Frame",badge,"Crater"..j,UDim2.fromOffset(dot[3],dot[3]),UDim2.fromOffset(dot[1],dot[2]),Color3.fromHex(moon.dark))
			shape(crater,4)
		end
		label(row,"Name",moon.name,UDim2.new(1,-144,0,22),UDim2.fromOffset(50,4),16,paper,Enum.Font.GothamBold)
		self.rows[i] = {
			info = label(row,"Rarity","",UDim2.new(1,-60,0,20),UDim2.fromOffset(50,26),12,muted),
			odds = label(row,"Odds","",UDim2.fromOffset(120,24),UDim2.new(1,-130,0,4),13,Color3.fromHex(moon.color))
		}
		self.rows[i].odds.TextXAlignment = Enum.TextXAlignment.Right
	end
	self.saveNote = label(scroll,"SaveMode","",UDim2.new(1,-10,0,32),UDim2.fromOffset(2,#Catalog.Moons*58),12,muted)
	self.upgrade = button(sheet,"Upgrade","Улучшить удачу",UDim2.new(1,-28,0,46),UDim2.new(0,14,1,-57),gold)
	for _, b in ipairs({self.atlas,self.luck}) do
		b.Activated:Connect(function() overlay.Visible = true end)
	end
	return self
end

function Interface:profile(data, practice)
	local owned = 0
	local chances = Catalog.chances(data.level)
	local nextChances = Catalog.chances(math.min(data.level+1,Catalog.MaxLevel))
	for i,moon in ipairs(Catalog.Moons) do
		local n = data.counts[moon.id] or 0
		if n > 0 then owned += 1 end
		self.rows[i].info.Text = string.format("%s  ·  Поймано %d",moon.rarity,n)
		self.rows[i].odds.Text = if data.level < Catalog.MaxLevel then
			string.format("%.2f → %.2f%%",chances[i]*100,nextChances[i]*100)
			else string.format("%.2f%%",chances[i]*100)
	end
	local luck = Catalog.luck(data.level)
	self.atlas.Text = string.format("Атлас   %d/%d",owned,#Catalog.Moons)
	self.stats.Text = string.format("Пыль %d   ·   Удача ×%.2f",data.dust,luck)
	self.saveNote.Text = "Шанс сейчас → после улучшения" .. (if practice then "\nStudio · прогресс на время теста" else "")
	local maxed = data.level >= Catalog.MaxLevel
	local price = Catalog.price(data.level)
	self.canUpgrade = not maxed and data.dust >= price
	self.upgrade.Text = if maxed then "Удача максимальная" else
		string.format("Удача ×%.2f → ×%.2f   ·   %d/%d пыли",luck,Catalog.luck(data.level+1),data.dust,price)
	self.upgrade.TextSize = 14
	self.upgrade.BackgroundColor3 = if self.canUpgrade then gold else panel
	self.upgrade.TextColor3 = if self.canUpgrade then ink else muted
	self.upgrade.AutoButtonColor = self.canUpgrade
	self.luck.Text = if self.canUpgrade then "Удача  ↑" else "Удача  +"
end

function Interface:progress(packet)
	self.fill.Size = UDim2.fromScale(packet.hits/packet.goal,1)
	self.meter.Text = string.format("%d / %d",packet.hits,packet.goal)
	self.status.TextColor3 = paper
	self.status.Text = if packet.paused then "Луна поймана!" elseif packet.crew > 1 then
		string.format("Ловим вместе · %d",packet.crew) elseif packet.hits > 0 then "Тянем Луну ближе" else "Нажимай на Луну или кнопку"
	self.tap.Text = if packet.paused then "Следующая орбита…" else "Ловить Луну"
	self.tap.AutoButtonColor = not packet.paused
end

function Interface:reveal(moon)
	self.status.TextColor3 = Color3.fromHex(moon.color)
	self.status.Text = string.format("%s  ·  +%d пыли",moon.name,moon.dust)
end

return Interface
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">MoonScene</string>
            <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local MoonScene = {}
MoonScene.__index = MoonScene

local center = Vector3.new(0, 16, 0)
local radius = 4.8
local function part(model, name, shape, size, frame, color, material)
	local p = Instance.new("Part")
	p.Name, p.Shape, p.Size, p.CFrame = name, shape, size, frame
	p.Anchored, p.CanCollide, p.CanTouch, p.CastShadow = true, false, false, false
	p.CanQuery = name == "LunarSurface"
	p.Material, p.Color, p.Parent = material or Enum.Material.SmoothPlastic, color, model
	return p
end

local function orbit(model, width, depth, tilt, color, thickness)
	local last
	for i = 0, 48 do
		local a = 2 * math.pi * i / 48
		local v = tilt:PointToWorldSpace(Vector3.new(math.cos(a)*width, 0, math.sin(a)*depth))
		if last then
			local p = part(model, "Orbit", Enum.PartType.Block, Vector3.new(thickness, thickness, (v-last).Magnitude+0.02),
				CFrame.lookAt((v+last)/2, v), color, Enum.Material.Neon)
			p.Transparency = 0.25
		end
		last = v
	end
end

function MoonScene.new()
	local self = setmetatable({pulse = 0, time = 0, elapsed = 0, anchors = {}, beams = {}}, MoonScene)
	for _,x in ipairs({-6,6}) do
		local peg = part(workspace,"TetherOrigin",Enum.PartType.Block,Vector3.one*0.1,
			CFrame.new(x,4.02,6.5),Color3.new(1,1,1))
		peg.Transparency = 1
		local hook = Instance.new("Attachment")
		hook.Parent = peg
		table.insert(self.anchors,hook)
	end
	self:show()
	RunService:BindToRenderStep("LunarObservatoryView", Enum.RenderPriority.Camera.Value+1, function(dt)
		local cam = workspace.CurrentCamera
		if not cam then return end
		cam.CameraType = Enum.CameraType.Scriptable
		cam.FieldOfView = 48
		cam.CFrame = CFrame.lookAt(Vector3.new(0, 13.5, 36), Vector3.new(0, 12.8, 0))
		cam.Focus = CFrame.new(center)
		self.time += dt
		self.elapsed += dt
		self.pulse = math.max(0, self.pulse-dt*3.5)
		if self.elapsed < 1/30 then return end
		self.elapsed = 0
		self.model:PivotTo(CFrame.new(center + Vector3.new(0, math.sin(self.time*1.3)*0.21+self.pulse*0.26,0))
			* CFrame.Angles(0, self.time*0.065, self.pulse*0.029))
	end)
	return self
end

function MoonScene:progress(packet)
	for i, beam in ipairs(self.beams) do
		beam.Enabled = packet.hits > 0 and not packet.paused and (i == 1 or packet.crew > 1)
		beam.CurveSize0 = 3.5 * (1 - packet.hits/packet.goal)
	end
	if packet.hits > 0 then self.pulse = 1 end
end

function MoonScene:show(moon, index)
	if self.model then self.model:Destroy() end
	local model = Instance.new("Model")
	model.Name = "PersonalMoon"
	local tint = Color3.fromHex(if moon then moon.color else "D7E2F3")
	local shade = Color3.fromHex(if moon then moon.dark else "879ABC")
	local ball = part(model, "LunarSurface", Enum.PartType.Ball, Vector3.one*radius*2, CFrame.identity, tint)
	model.PrimaryPart = ball
	table.clear(self.beams)
	for i, hook in ipairs(self.anchors) do
		local endpoint = Instance.new("Attachment")
		endpoint.Position = Vector3.new(if i==1 then -1.9 else 1.9,-3.9,1.8)
		endpoint.Parent = ball
		local beam = Instance.new("Beam")
		beam.Attachment0,beam.Attachment1 = hook,endpoint
		beam.Color = ColorSequence.new(Color3.fromHex("FFCB80"),Color3.fromHex("D9F6FF"))
		beam.Width0,beam.Width1,beam.FaceCamera,beam.LightEmission = 0.13,0.07,true,0.9
		beam.Enabled,beam.Parent = false,ball
		table.insert(self.beams,beam)
	end
	if moon then
		local sparks = Instance.new("ParticleEmitter")
		sparks.Rate, sparks.Lifetime, sparks.Speed = 0,NumberRange.new(0.6,1.15),NumberRange.new(6,13)
		sparks.SpreadAngle = Vector2.new(180,180)
		sparks.Color, sparks.LightEmission = ColorSequence.new(tint),1
		sparks.Size = NumberSequence.new({NumberSequenceKeypoint.new(0,0.35),NumberSequenceKeypoint.new(1,0)})
		sparks.Parent = ball
		task.defer(function() if sparks:IsDescendantOf(workspace) then sparks:Emit(28) end end)
	end
	local rng = Random.new(116)
	for i=1,37 do
		local y = 1 - (i-0.5)*2/37
		local a = i*2.39996
		local n = Vector3.new(math.sqrt(1-y*y)*math.cos(a), y, math.sqrt(1-y*y)*math.sin(a))
		local tangent = n:Cross(Vector3.yAxis).Unit
		local size = rng:NextNumber(0.48,1.52)
		local surface = CFrame.fromMatrix(n*(radius-0.025), n, tangent)
		part(model,"Crater rim",Enum.PartType.Cylinder,Vector3.new(0.07,size,size*0.91),surface,tint:Lerp(shade,0.26))
		part(model,"Crater floor",Enum.PartType.Cylinder,Vector3.new(0.08,size*0.75,size*0.70),
			surface*CFrame.new(0.028,size*0.03,0),tint:Lerp(shade,0.55))
	end
	local tilt = CFrame.Angles(math.rad(-12),0,math.rad(-19))
	orbit(model,7.2,6.3,tilt,Color3.fromHex("DEB67D"),0.052)
	if index and index >= 3 then
		orbit(model,7.6,7,tilt,tint,0.11)
	end
	if index and index >= 4 then
		part(model,"Satellite",Enum.PartType.Ball,Vector3.one*1.15,tilt*CFrame.new(-7,0,1),shade,Enum.Material.Neon)
	end
	if index == 5 then
		orbit(model,7.5,6.8,CFrame.Angles(0,0,1.12),tint,0.09)
	end
	local glow = Instance.new("PointLight")
	glow.Color, glow.Brightness, glow.Range, glow.Parent = tint, 2, 32, ball
	model:PivotTo(CFrame.new(center))
	model.Parent = workspace
	self.model = model
end

function MoonScene:hitTest(point)
	local cam = workspace.CurrentCamera
	if not cam then return false end
	local ray = cam:ViewportPointToRay(point.X, point.Y)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Include
	params.FilterDescendantsInstances = { self.model }
	return workspace:Raycast(ray.Origin, ray.Direction * 150, params) ~= nil
end

return MoonScene
